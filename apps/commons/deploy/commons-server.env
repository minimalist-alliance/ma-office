# commons-server's settings on a guild desk, read by its unit (EnvironmentFile) and passed on by run. Root-owned. No
# secrets belong here, and the service has none: it trusts deskd by SO_PEERCRED.
# A desk's own overrides go in /etc/ma/commons-server.env, which the unit reads after this file.

# Boards, chat threads, settings and the audit log. The only place they are, and only commons reads it.
MA_APP_DATA=/data/guild/commons
# MiB. Go's soft memory limit is 90% of this; the unit's MemoryMax is the hard one.
MA_APP_MEMORY_MAX=768

# deskd's relay socket and deskd's uid (README, "On a guild desk").
COMMONS_RELAY_SOCKET=/run/desk-commons/commons.sock
COMMONS_RELAY_UID=1100

# /healthz and /stats (counts only), on loopback. Nothing else is served over HTTP on a guild desk.
COMMONS_HTTP=127.0.0.1:8790

# Voice: UDP from this port up, one port per core, at most 8 (8791-8794 on a 4-vCPU c7g.xlarge). The security group
# opens them to members' browsers.
COMMONS_UDP=0.0.0.0:8791
# The public IPv4 members reach voice on. Empty: run reads /run/commons-server.address, which
# commons-server-address.service writes from the instance metadata service (Commons itself may not reach it).
COMMONS_ADVERTISE=

# The roster's maxCommonsChannels: the most channels a guild may set (guilds#current, default 10).
COMMONS_MAX_CHANNELS=10

# Voice for members whose network blocks UDP 8791 and up: desk-rtc takes Commons' ICE on the guild desk's port 443
# (UDP, and TCP as ICE-TCP), tells it from its own by the ufrag (Commons' all start with "cmns"), and relays it here.
# Answers name the public address on COMMONS_ICE_RELAY_PORT, UDP and TCP, below the direct UDP ports. Loopback only.
COMMONS_ICE_RELAY=127.0.0.1:8799
COMMONS_ICE_RELAY_PORT=443

# Voice policing (Security's NET031-2): each talker is held to Opus voice, packets over the cap are dropped before they
# are forwarded or counted to listeners, and after COMMONS_POLICE_ABUSE_SECS seconds in a row over, the talker's voice
# connection is closed. These are the defaults; a browser sends about 50 packets and 32 to 64 kbit/s.
COMMONS_POLICE_KBPS=128
COMMONS_POLICE_PPS=100
COMMONS_POLICE_MAX_BYTES=400
COMMONS_POLICE_ABUSE_SECS=5
