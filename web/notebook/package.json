{
  "name": "ma-desk-notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Minimalist Alliance Notebook editor: a standalone module (TipTap 3 + Yjs) that the Desk app adopts later. Storage and sync sit behind NotebookBackend; this package ships a local browser backend only.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./notebook.css": "./src/ui/notebook.css",
    "./vite-plugin": "./vite-plugins/notebookThemes.ts"
  },
  "scripts": {
    "demo": "vite build && vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node ../scripts/check-css-literals.mjs",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "perf": "vite build && node tests/perf/perf.mjs",
    "record": "vite build && node tests/perf/record.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
