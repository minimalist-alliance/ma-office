{
  "name": "ma-desk-agent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Agent app's front end for the Desk: a standalone module with a mock client, wired into web/ later by the UI/UX Engineer.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node ../scripts/check-css-literals.mjs",
    "test": "vitest run",
    "build": "vite build",
    "serve": "node tests/serve.mjs --port 5184",
    "e2e": "npm run build && playwright test",
    "record": "npm run build && node tests/record.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
