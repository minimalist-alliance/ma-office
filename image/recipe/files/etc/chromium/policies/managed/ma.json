{
  "RestoreOnStartup": 1,
  "AudioCaptureAllowed": false,
  "VideoCaptureAllowed": false,
  "DownloadDirectory": "/data/browser/downloads",
  "PromptForDownloadLocation": false,
  "URLBlocklist": [
    "office.minimalistalliance.com",
    "desk.minimalistalliance.com",
    "api.minimalistalliance.com",
    "auth.minimalistalliance.com",
    "gw.minimalistalliance.com",
    "office.staging.minimalistalliance.com",
    "desk.staging.minimalistalliance.com",
    "api.staging.minimalistalliance.com",
    "auth.staging.minimalistalliance.com",
    "gw.staging.minimalistalliance.com"
  ],
  "DefaultBrowserSettingEnabled": false,
  "BrowserSignin": 0,
  "SyncDisabled": true,
  "MetricsReportingEnabled": false,
  "BackgroundModeEnabled": false,
  "HomepageLocation": "file:///usr/local/share/ma/home.html",
  "ExtensionInstallBlocklist": ["*"],
  "ExtensionAllowedTypes": ["extension"],
  "BlockExternalExtensions": true,
  "AutoLaunchProtocolsFromOrigins": [
    {"protocol": "tel", "allowed_origins": ["*"]},
    {"protocol": "sms", "allowed_origins": ["*"]},
    {"protocol": "zoommtg", "allowed_origins": ["*"]},
    {"protocol": "msteams", "allowed_origins": ["*"]},
    {"protocol": "facetime", "allowed_origins": ["*"]},
    {"protocol": "webcal", "allowed_origins": ["*"]}
  ]
}
