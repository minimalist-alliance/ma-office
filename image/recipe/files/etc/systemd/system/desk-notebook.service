[Unit]
Description=desk-notebook (the Notebook's pages; Node in Docker with no network, runs as root to call the Docker CLI)
ConditionPathExists=/opt/ma/desk-notebook/current/run
Requires=docker.service desk-datadirs.service
# desk-agent's shape, less what it has for the network: this container has none (--network none). It starts beside deskd
# and neither waits for the other: deskd reconnects to notebook.sock with backoff, and its health never needs this unit.
After=docker.service desk-datadirs.service
StartLimitIntervalSec=0

[Service]
Environment=RELEASE_DIR=/opt/ma/desk-notebook/current
ExecStartPre=-/usr/bin/docker rm -f desk-notebook
ExecStart=/opt/ma/desk-notebook/current/run
ExecStartPost=-/usr/local/lib/ma/desk-oom-container desk-notebook -200
# SIGTERM stores every page and checkpoints the WAL, so it gets 30 s.
ExecStop=/usr/bin/docker stop -t 30 desk-notebook
TimeoutStopSec=40
Restart=always
RestartSec=3
RestartSteps=8
RestartMaxDelaySec=300
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target
