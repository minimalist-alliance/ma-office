[Unit]
Description=desk-agent-filter (holds uid 1103 to the providers' names, ADR 0070)
ConditionPathExists=/opt/ma/desk-agent-filter/current/run
After=nftables.service systemd-resolved.service
Wants=systemd-resolved.service
Before=desk-agent.service
# It keeps trying for as long as it takes. While it's down, uid 1103 is refused: nftables has no other way out for it.
StartLimitIntervalSec=0

[Service]
Environment=RELEASE_DIR=/opt/ma/desk-agent-filter/current
# GOMEMLIMIT holds the program's own heap far under MemoryMax. GOMAXPROCS as a t4g.medium has.
Environment=GOMEMLIMIT=20MiB GOMAXPROCS=2
ExecStart=/opt/ma/desk-agent-filter/current/run
User=agent-filter
Group=agent-filter
Restart=always
RestartSec=1
RestartSteps=8
RestartMaxDelaySec=300
TimeoutStopSec=5
# The kernel charges each connection's socket buffers here too. The program sets them (0.1.1 on), so its 64 connections
# with every buffer full come to 74 MiB, and the DNS side's to 2 MiB: this leaves room for the program's few. Idle, it uses
# about 4 MiB (ADR 0070).
MemoryMax=96M
TasksMax=64
# Six descriptors a connection at worst, the two sockets and two pipes: 384 for 64 connections, and the DNS side, with room.
LimitNOFILE=2048
# As tight as it runs. Any socket it needs is IPv4 or IPv6, and journald is its stderr, which is already open.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
InaccessiblePaths=-/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete @cpu-emulation @raw-io @reboot @swap @clock @module
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
