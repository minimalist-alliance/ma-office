#!/usr/bin/python3 -I
"""desk-data: reads the member's files on /data for deskd's export and move (draft-data-export-and-transfer.md).

Runs as root, one process per connection on /run/desk/data.sock, with the connection on stdin, like desk-units.
Only uid 1100 (deskd). Three ops, all read-only: parts, manifest, read. The protocol is the ADR's appendix.

It never writes, renames or deletes anything under /data except its own scratch copies in /data/.ma-export-tmp,
never follows a symlink, never opens a path outside the part asked for, and never starts a program.
"""
import contextlib
import csv
import datetime
import errno
import fcntl
import hashlib
import html
import json
import os
import resource
import secrets
import socket
import sqlite3
import stat
import struct
import sys
import time
import urllib.parse

HELPER_VERSION = "1.0.0"
DESK_UID = 1100
DATA_ROOT = "/data"
SCRATCH = ".ma-export-tmp"

MAX_REQUEST = 16384         # bytes, the newline included
MAX_LIMIT = 2000            # manifest entries a page
IDLE_TIMEOUT_S = 30         # a peer that sends no request for this long is dropped (deskd sends it at once)
STALL_TIMEOUT_S = 330       # a reader that takes nothing for this long is dropped. Past deskd's 5 minutes without
                            # credit (API.md section 12), after which deskd ends the transfer and closes this end
                            # itself, so that's the limit a reader meets; this is only the backstop
CHUNK = 65536               # body chunk, at most
HASH_BLOCK = 1 << 20        # reading the part before a resumed offset
MAX_PATH_BYTES = 4000       # longer paths are left out; a UTF-8 one this long fits a request even \u-escaped
MAX_COMPONENT_BYTES = 255
BUSY_S = 10                 # how long a locked SQLite database is retried before the read fails
ONLINE_S = 1                # of which the online backup gets this long before the quiet copy is tried
QUIET_MS = 200              # the quiet copy needs this long since the last write (coarse mtime is ~4 ms)
SETTLE_MS = 50              # a plain file is read once its ctime is this old, so a write during the read moves it
FREE_FLOOR = 2 << 30        # a scratch copy must leave this much free on /data (the Browser's floor, app contract 2.4)
ROOM_FILE = "room"          # in a helper's own scratch directory: the bytes its copy in progress may still write
MAX_BOOKMARKS_BYTES = 16 << 20   # far past any real one; the conversion holds it in memory

SQLITE_HEADER = b"SQLite format 3\x00"
SQLITE_SIBLINGS = ("-journal", "-wal", "-shm")
NOT_A_DATABASE = ("SQLITE_NOTADB", "SQLITE_CORRUPT")

# Decision 4: what belongs to the machine, not the member.
MACHINE_PARTS = {"rtc", "selfhost", "desk-egress", "lost+found", SCRATCH, ".ma-move"}
READABLE = "browser-readable"   # made by the helper. A stored directory of that name would be shadowed: left out
BROWSER_CACHES = {
    "Cache", "Code Cache", "GPUCache", "DawnCache", "DawnGraphiteCache", "DawnWebGPUCache", "GrShaderCache",
    "GraphiteDawnCache", "ShaderCache", "component_crx_cache", "Crashpad",
    "SingletonLock", "SingletonCookie", "SingletonSocket",
}
APP_PACKAGES = {"releases", "current", "previous", "cache"}
LABELS = {
    "browser": "Browser",
    "desk": "Desk settings and Chat",
    "notebook": "Notebook",
    "agent": "Agent",
    "apps": "Apps",
    "files": "Files",
    READABLE: "Bookmarks and history",
}
READABLE_FILES = {"bookmarks.html": "Bookmarks", "history.csv": "History"}

O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
O_FILE = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK   # NONBLOCK: a FIFO can't hang the open
WEBKIT_EPOCH = datetime.datetime(1601, 1, 1, tzinfo=datetime.timezone.utc)
UNIX_FROM_WEBKIT_S = 11644473600


class Changing(Exception):
    """A database was written while it was being copied: try again."""


class Refusal(Exception):
    """A reply header with ok:false."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def log(msg):
    print(f"desk-data: {msg}", file=sys.stderr, flush=True)


def close_quietly(fd):
    if fd is not None and fd >= 0:
        try:
            os.close(fd)
        except OSError:
            pass


def errname(e):
    return getattr(e, "sqlite_errorname", "") or ""


def open_fds():
    """{fd: (st_dev, st_ino)} of this process's open files."""
    out = {}
    for n in os.listdir("/proc/self/fd"):
        try:
            st = os.fstat(int(n))
        except OSError:
            continue   # the listing's own fd, closed by now
        out[int(n)] = (st.st_dev, st.st_ino)
    return out


def file_state(st):
    """What a read compares before and after. A write, a truncate, a chmod or the file being replaced moves ctime,
    which, unlike mtime, no program can set back."""
    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)


def empty_dir(fd):
    """Remove everything in a directory of the helper's own scratch, without following a link."""
    for n in os.listdir(fd):
        try:
            os.unlink(n, dir_fd=fd)
        except IsADirectoryError:
            try:
                sub = os.open(n, O_DIR, dir_fd=fd)
                try:
                    empty_dir(sub)
                finally:
                    os.close(sub)
                os.rmdir(n, dir_fd=fd)
            except OSError:
                pass
        except OSError:
            pass


# ---------------------------------------------------------------- request

def _no_duplicates(pairs):
    out = {}
    for k, v in pairs:
        if k in out:
            raise ValueError(f"duplicate field {k}")
        out[k] = v
    return out


def _no_constants(name):
    raise ValueError(f"{name} isn't JSON")


def is_int(v):
    return type(v) is int


def parse_request(line):
    try:
        req = json.loads(line.decode("utf-8"), object_pairs_hook=_no_duplicates, parse_constant=_no_constants)
    except (UnicodeDecodeError, ValueError, RecursionError) as e:
        raise Refusal("bad_request", f"the request isn't one line of JSON: {e}"[:200])
    if not isinstance(req, dict):
        raise Refusal("bad_request", "the request must be a JSON object")
    if req.get("v") != 1 or not is_int(req.get("v")):
        raise Refusal("bad_request", 'expected "v": 1')
    op = req.get("op")
    allowed = {"parts": set(), "manifest": {"part", "cursor", "limit"}, "read": {"part", "path", "offset"}}
    if op not in allowed:
        raise Refusal("bad_request", "op must be parts, manifest or read")
    extra = set(req) - {"v", "op"} - allowed[op]
    if extra:
        raise Refusal("bad_request", f"unknown field {sorted(extra)[0]!r} for {op}")
    if op == "manifest":
        limit = req.get("limit", MAX_LIMIT)
        if not is_int(limit) or not 1 <= limit <= MAX_LIMIT:
            raise Refusal("bad_request", f"limit must be an integer from 1 to {MAX_LIMIT}")
        req["limit"] = limit
        if req.get("cursor") is not None and not isinstance(req["cursor"], str):
            raise Refusal("bad_request", "cursor must be a path or null")
    if op == "read":
        offset = req.get("offset", 0)
        if not is_int(offset) or not 0 <= offset < 1 << 63:
            raise Refusal("bad_request", "offset must be a whole number of bytes")
        req["offset"] = offset
        if not isinstance(req.get("path"), str):
            raise Refusal("bad_request", "path must be a string")
    if op in ("manifest", "read") and not isinstance(req.get("part"), str):
        raise Refusal("bad_request", "part must be a string")
    return req


def check_component(name):
    """The component's bytes, or a Refusal. Names that aren't UTF-8 travel as Python's surrogateescape (\\udcXX)."""
    if name in ("", ".", "..") or "/" in name or "\x00" in name:
        raise Refusal("invalid", "bad path")
    try:
        b = os.fsencode(name)
    except UnicodeEncodeError:
        raise Refusal("invalid", "bad path: not UTF-8")
    if len(b) > MAX_COMPONENT_BYTES:
        raise Refusal("invalid", f"bad path: a name over {MAX_COMPONENT_BYTES} bytes")
    return b


def split_path(path):
    """('a', 'b') and their bytes for 'a/b'. Relative, '/'-separated, no empty, '.' or '..' components, no NUL."""
    if not path or path.startswith("/"):
        raise Refusal("invalid", "bad path: empty or absolute")
    if "\x00" in path:
        raise Refusal("invalid", "bad path: NUL")
    comps = tuple(path.split("/"))
    keys = tuple(check_component(c) for c in comps)
    if len(os.fsencode(path)) > MAX_PATH_BYTES:
        raise Refusal("invalid", "bad path: too long")
    return comps, keys


# ---------------------------------------------------------------- what's left out

def excluded(part, comps):
    """True when a path inside a part belongs to the machine or is a rebuildable cache (decision 4)."""
    n = len(comps)
    if part == "browser":
        return n in (2, 3) and comps[0] == "profile" and comps[-1] in BROWSER_CACHES
    if part == "desk":
        return comps == ("volume.json",)
    if part == "apps":
        return comps == ("registry.json",) or (n == 2 and comps[1] in APP_PACKAGES)
    return False


def excluded_prefix(part, comps):
    return any(excluded(part, comps[:i]) for i in range(1, len(comps) + 1))


def read_header(dir_fd, name):
    """The first 16 bytes of a regular file, without following a link or blocking on a FIFO, or b''."""
    try:
        st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        if not stat.S_ISREG(st.st_mode):
            return b""
        fd = os.open(name, O_FILE, dir_fd=dir_fd)
    except OSError:
        return b""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return b""
        return os.pread(fd, 16, 0)
    except OSError:
        return b""
    finally:
        os.close(fd)


def is_sqlite_sibling(dir_fd, name):
    for suffix in SQLITE_SIBLINGS:
        base = name[: -len(suffix)]
        if name.endswith(suffix) and base and read_header(dir_fd, base) == SQLITE_HEADER:
            return True
    return False


def sibling_size(dir_fd, name, suffix):
    try:
        st = os.stat(name + suffix, dir_fd=dir_fd, follow_symlinks=False)
        return st.st_size if stat.S_ISREG(st.st_mode) else 0
    except OSError:
        return 0


def sqlite_siblings(dir_fd, names):
    """The -journal, -wal and -shm files in a directory whose database is beside them (decision 5)."""
    present = set(names)
    out, checked = set(), {}
    for n in names:
        for suffix in SQLITE_SIBLINGS:
            if n.endswith(suffix) and len(n) > len(suffix):
                base = n[: -len(suffix)]
                if base in present:
                    if base not in checked:
                        checked[base] = read_header(dir_fd, base) == SQLITE_HEADER
                    if checked[base]:
                        out.add(n)
    return out


# ---------------------------------------------------------------- the helper

class Helper:
    """One connection. `root` is /data; only the tests pass another (main() never does)."""

    def __init__(self, root=DATA_ROOT, allowed_uid=DESK_UID, *, free_floor=FREE_FLOOR, busy_s=BUSY_S,
                 online_s=ONLINE_S, quiet_ms=QUIET_MS, settle_ms=SETTLE_MS, idle_timeout_s=IDLE_TIMEOUT_S,
                 stall_timeout_s=STALL_TIMEOUT_S):
        self.root = root
        self.allowed_uid = allowed_uid
        self.free_floor = free_floor
        self.busy_s = busy_s
        self.online_s = online_s
        self.quiet_ms = quiet_ms
        self.settle_ms = settle_ms
        self.idle_timeout_s = idle_timeout_s
        self.stall_timeout_s = stall_timeout_s
        self.header_sent = False
        self.data_fd = None
        self.scratch_fd = None     # this connection's own directory in /data/.ma-export-tmp
        self.scratch_name = None
        self.scratch_parent = None
        self.reserved = 0          # bytes this helper's copies in progress may still write (its room file)

    # ---- connection

    def serve(self, conn):
        try:
            self._serve(conn)
        finally:
            self._drop_scratch()
            close_quietly(self.data_fd)
            try:
                conn.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    def _serve(self, conn):
        uid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))[1]
        if uid != self.allowed_uid:
            log(f"refused uid {uid}")
            self._send_header(conn, {"ok": False, "code": "denied", "message": "only deskd may use this socket"})
            return
        conn.settimeout(self.idle_timeout_s)
        op = "?"
        try:
            req = parse_request(self._read_request(conn))
            op = req["op"]
            self.data_fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            self._clean_scratch()
            if op == "parts":
                self._send_header(conn, self.op_parts())
            elif op == "manifest":
                self._send_header(conn, self.op_manifest(req["part"], req.get("cursor"), req["limit"]))
            else:
                self.op_read(conn, req["part"], req["path"], req["offset"])
        except Refusal as r:
            log(f"{op}: {r.code}: {r.message}")
            self._refuse(conn, r.code, r.message)
        except (socket.timeout, BrokenPipeError, ConnectionResetError):
            log(f"{op}: the peer went away or stalled")
        except Exception as e:  # noqa: BLE001  answer, rather than die with a trace that names member files
            log(f"{op}: failed: {type(e).__name__}")
            self._refuse(conn, "failed", f"internal error ({type(e).__name__})")

    def _refuse(self, conn, code, message):
        """A refusal header, unless a body has begun: then the body just stops short, which deskd sees."""
        if not self.header_sent:
            self._send_header(conn, {"ok": False, "code": code, "message": message})

    def _read_request(self, conn):
        deadline = time.monotonic() + self.idle_timeout_s
        data = b""
        while b"\n" not in data and len(data) <= MAX_REQUEST:
            left = deadline - time.monotonic()
            if left <= 0:
                raise socket.timeout()
            conn.settimeout(left)
            chunk = conn.recv(MAX_REQUEST + 1 - len(data))
            if not chunk:
                break
            data += chunk
        conn.settimeout(self.stall_timeout_s)
        line, nl, rest = data.partition(b"\n")
        if not nl or len(line) + 1 > MAX_REQUEST:
            raise Refusal("bad_request", f"expected one line of JSON of at most {MAX_REQUEST} bytes, ending \\n")
        if rest:
            raise Refusal("bad_request", "one request per connection")
        return line

    def _send_header(self, conn, obj):
        self.header_sent = True
        try:
            conn.sendall(json.dumps(obj, separators=(",", ":")).encode("ascii") + b"\n")
        except OSError:
            pass

    # ---- parts

    def part_names(self):
        """Top-level directories of /data that hold the member's data, sorted by their bytes."""
        out = []
        for name in os.listdir(self.data_fd):
            if name in MACHINE_PARTS or name == READABLE:
                continue
            try:
                st = os.stat(name, dir_fd=self.data_fd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                out.append(name)
        return sorted(out, key=os.fsencode)

    def open_part(self, part):
        """An O_NOFOLLOW directory fd for a stored part, or not_found."""
        check_component(part)
        if part in MACHINE_PARTS or part == READABLE:
            raise Refusal("not_found", "no such part")
        try:
            return os.open(part, O_DIR, dir_fd=self.data_fd)
        except OSError:
            raise Refusal("not_found", "no such part")

    def op_parts(self):
        parts = []
        for name in self.part_names():
            try:
                fd = os.open(name, O_DIR, dir_fd=self.data_fd)
            except OSError:
                continue
            files = size = 0
            try:
                for e in self.walk(name, fd):
                    if e["type"] == "file":
                        files += 1
                        size += e["size"]
            finally:
                os.close(fd)
            parts.append({"part": name, "label": LABELS.get(name, name), "files": files, "bytes": size})
        readable = self.readable_entries()
        if readable is not None:
            files = [e for e in readable if e["type"] == "file"]
            parts.append({"part": READABLE, "label": LABELS[READABLE], "files": len(files),
                          "bytes": sum(e["size"] for e in files)})
        parts.sort(key=lambda p: os.fsencode(p["part"]))
        return {"ok": True, "helperVersion": HELPER_VERSION, "parts": parts}

    # ---- manifest

    def walk(self, part, part_fd, after=None):
        """Entries in a depth-first walk, names sorted by their bytes, after the path `after` (bytes components).

        That order is the order of the paths' components compared as bytes, so a cursor skips whole subtrees.
        Never follows a symlink: a directory is opened O_NOFOLLOW from its parent and must be the inode listed.
        """
        frames = []

        def push(fd, key, comps):
            try:
                names = os.listdir(fd)
            except OSError:
                names = []
            skip = sqlite_siblings(fd, names)
            entries = sorted((os.fsencode(n), n) for n in names if n not in skip)
            frames.append([fd, key, comps, entries, 0])

        push(os.dup(part_fd), (), ())
        try:
            while frames:
                f = frames[-1]
                fd, pkey, pcomps, entries, i = f
                if i >= len(entries):
                    os.close(fd)
                    frames.pop()
                    continue
                f[4] = i + 1
                bname, name = entries[i]
                key, comps = pkey + (bname,), pcomps + (name,)
                if after is not None and key < after and after[: len(key)] != key:
                    continue   # this entry and everything under it came before the cursor
                if excluded(part, comps) or sum(len(k) + 1 for k in key) - 1 > MAX_PATH_BYTES:
                    continue
                try:
                    st = os.stat(name, dir_fd=fd, follow_symlinks=False)
                except OSError:
                    continue
                path = "/".join(comps)
                entry = {"path": path, "size": 0, "mtimeMs": st.st_mtime_ns // 1_000_000,
                         "mode": stat.S_IMODE(st.st_mode)}
                if stat.S_ISREG(st.st_mode):
                    entry["type"], entry["size"] = "file", st.st_size
                elif stat.S_ISDIR(st.st_mode):
                    entry["type"] = "dir"
                elif stat.S_ISLNK(st.st_mode):
                    entry["type"] = "link"
                    try:
                        entry["target"] = os.readlink(name, dir_fd=fd)
                    except OSError:
                        entry["target"] = ""
                else:
                    continue   # FIFOs, sockets, devices: not data
                if after is None or key > after:
                    yield entry
                if entry["type"] == "dir":
                    try:
                        sub = os.open(name, O_DIR, dir_fd=fd)
                    except OSError:
                        continue
                    sst = os.fstat(sub)
                    if (sst.st_dev, sst.st_ino) != (st.st_dev, st.st_ino):
                        os.close(sub)   # swapped since it was listed
                        continue
                    push(sub, key, comps)
        finally:
            for f in frames:
                close_quietly(f[0])

    def op_manifest(self, part, cursor, limit):
        after = split_path(cursor)[1] if cursor is not None else None
        if part == READABLE:
            entries = self.readable_entries()
            if entries is None:
                raise Refusal("not_found", "no such part")
            keyed = [(tuple(os.fsencode(c) for c in e["path"].split("/")), e) for e in entries]
            page = [e for k, e in keyed if after is None or k > after][: limit + 1]
        else:
            fd = self.open_part(part)
            try:
                page = []
                gen = self.walk(part, fd, after)
                try:
                    for e in gen:
                        page.append(e)
                        if len(page) > limit:
                            break
                finally:
                    gen.close()
            finally:
                os.close(fd)
        more = len(page) > limit
        page = page[:limit]
        return {"ok": True, "entries": page, "next": page[-1]["path"] if more else None}

    # ---- safe opening

    def open_in_part(self, part_fd, comps):
        """(dir_fd, file_fd, stat) for a regular file, every component opened O_NOFOLLOW from the part's root."""
        fd = os.dup(part_fd)
        try:
            for c in comps[:-1]:
                try:
                    nfd = os.open(c, O_DIR, dir_fd=fd)
                except OSError as e:
                    if e.errno in (errno.ENOENT,):
                        raise Refusal("not_found", "no such file")
                    if e.errno in (errno.ELOOP, errno.ENOTDIR):
                        raise Refusal("invalid", "a link or a file in the middle of the path")
                    raise
                os.close(fd)
                fd = nfd
            name = comps[-1]
            try:
                lst = os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                raise Refusal("not_found", "no such file")
            if not stat.S_ISREG(lst.st_mode):
                raise Refusal("invalid", "not a regular file" + (" (a link)" if stat.S_ISLNK(lst.st_mode) else ""))
            try:
                ffd = os.open(name, O_FILE, dir_fd=fd)
            except OSError as e:
                if e.errno == errno.ENOENT:
                    raise Refusal("not_found", "no such file")
                if e.errno == errno.ELOOP:
                    raise Refusal("invalid", "not a regular file (a link)")
                raise
            st = os.fstat(ffd)
            if not stat.S_ISREG(st.st_mode) or (st.st_dev, st.st_ino) != (lst.st_dev, lst.st_ino):
                os.close(ffd)
                raise Refusal("invalid", "not a regular file")
            fcntl.fcntl(ffd, fcntl.F_SETFL, fcntl.fcntl(ffd, fcntl.F_GETFL) & ~os.O_NONBLOCK)
            return fd, ffd, st
        except BaseException:
            os.close(fd)
            raise

    # ---- read

    def op_read(self, conn, part, path, offset):
        comps, _ = split_path(path)
        before = None   # a file read in place: its state once settled. A scratch copy is ours, and nothing writes it
        if part == READABLE:
            src_fd, mtime_ns = self.make_readable(comps)
        else:
            part_fd = self.open_part(part)
            try:
                if excluded_prefix(part, comps):
                    raise Refusal("not_found", "no such file")
                dir_fd, fd, st = self.open_in_part(part_fd, comps)
            finally:
                os.close(part_fd)
            try:
                if is_sqlite_sibling(dir_fd, comps[-1]):
                    raise Refusal("not_found", "no such file")   # left out of manifests, so left out here
                mtime_ns = st.st_mtime_ns
                copy = self.sqlite_copy(dir_fd, comps[-1], fd, st) if os.pread(fd, 16, 0) == SQLITE_HEADER else None
                if copy is None:
                    src_fd, fd = fd, None
                    try:
                        before = self.settled(src_fd)
                    except BaseException:
                        os.close(src_fd)
                        raise
                    mtime_ns = before.st_mtime_ns
                else:
                    src_fd = self.open_scratch_file(copy)
            finally:
                close_quietly(fd)
                os.close(dir_fd)
        try:
            if before is None:
                before = os.fstat(src_fd)
            self._send_header(conn, {"ok": True, "size": before.st_size, "mtimeMs": mtime_ns // 1_000_000})
            self.send_body(conn, src_fd, before, offset)
        finally:
            os.close(src_fd)

    def settled(self, fd):
        """The file's stat once nothing has changed it for settle_ms. Timestamps come from a coarse clock (a few ms),
        so a write in the same tick as the one before could leave them as they were; after this, any write during
        the read moves ctime. ctime, as a program can set mtime to anything, even the future, but not ctime."""
        deadline = time.monotonic() + self.busy_s
        window = self.settle_ms * 1_000_000
        while True:
            st = os.fstat(fd)
            age = time.time_ns() - st.st_ctime_ns
            if abs(age) >= window:   # a ctime ahead of the clock (the clock went back) can't be met by a new one
                return st
            if time.monotonic() >= deadline:
                raise Refusal("failed", f"the file kept changing for {self.busy_s} s")
            time.sleep(max(0.005, (window - age) / 1e9 if age >= 0 else window / 1e9))

    def send_body(self, conn, fd, before, offset):
        """Chunks from `offset`, a u32be 0, then SHA-256 of bytes 0 to the end and u64be of how many that was.

        The hash is of what was sent, so it can't see a file rewritten in place while it was read: the body would be
        old bytes and new, and the trailer would match them. So the file's state (file_state) after the last byte
        must be what it was before the first one, or the body stops short with no trailer, deskd sends an END with
        an empty payload, and the reader asks again. A file that shrank or grew while it was read ends the same way.
        """
        size = before.st_size
        h = hashlib.sha256()
        pos = 0
        start = min(offset, size)
        while pos < start:   # the part before a resumed offset, hashed here so the trailer covers the whole file
            b = os.pread(fd, min(HASH_BLOCK, start - pos), pos)
            if not b:
                break
            h.update(b)
            pos += len(b)
        if pos == offset:
            while pos < size:
                b = os.pread(fd, min(CHUNK, size - pos), pos)
                if not b:
                    break   # shrank: the check below ends it with no trailer
                h.update(b)
                pos += len(b)
                conn.sendall(struct.pack(">I", len(b)) + b)
        if file_state(os.fstat(fd)) != file_state(before):
            raise Refusal("failed", "the file changed while it was read")   # after the header: no trailer
        conn.sendall(struct.pack(">I", 0) + h.digest() + struct.pack(">Q", pos))

    # ---- scratch

    def _clean_scratch(self):
        """Make sure /data/.ma-export-tmp is ours and 0700, and empty it of everything no live helper holds."""
        try:
            try:
                os.mkdir(SCRATCH, 0o700, dir_fd=self.data_fd)
            except FileExistsError:
                pass
            pfd = os.open(SCRATCH, O_DIR, dir_fd=self.data_fd)
        except OSError:
            return   # read-only and missing: reads of SQLite files fail, nothing else does
        st = os.fstat(pfd)
        if st.st_uid != os.geteuid():
            os.close(pfd)
            return
        if stat.S_IMODE(st.st_mode) != 0o700:
            try:
                os.fchmod(pfd, 0o700)
            except OSError:
                os.close(pfd)
                return
        self.scratch_parent = pfd
        for name in os.listdir(pfd):
            try:
                lst = os.stat(name, dir_fd=pfd, follow_symlinks=False)
                if not stat.S_ISDIR(lst.st_mode):
                    os.unlink(name, dir_fd=pfd)
                    continue
                cfd = os.open(name, O_DIR, dir_fd=pfd)
            except OSError:
                continue
            try:
                fcntl.flock(cfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                os.close(cfd)
                continue   # a live helper's
            try:
                empty_dir(cfd)
                os.rmdir(name, dir_fd=pfd)
            except OSError:
                pass
            finally:
                os.close(cfd)

    def scratch(self):
        """This connection's own scratch directory, flock()ed while it lives so no other helper empties it."""
        if self.scratch_fd is not None:
            return self.scratch_fd
        if self.scratch_parent is None:
            raise Refusal("failed", f"the scratch directory {SCRATCH} on /data is missing or isn't root's")
        for _ in range(5):
            name = f"c{os.getpid()}-{secrets.token_hex(4)}"
            os.mkdir(name, 0o700, dir_fd=self.scratch_parent)
            fd = os.open(name, O_DIR, dir_fd=self.scratch_parent)
            fcntl.flock(fd, fcntl.LOCK_EX)
            if os.fstat(fd).st_nlink > 0:
                self.scratch_fd, self.scratch_name = fd, name
                return fd
            os.close(fd)   # another helper's cleanup took it between mkdir and flock: make another
        raise Refusal("failed", "couldn't make a scratch directory")

    def scratch_path(self, name):
        return os.path.join(self.root, SCRATCH, self.scratch_name, name)

    def _drop_scratch(self):
        if self.scratch_fd is not None:
            try:
                empty_dir(self.scratch_fd)
                os.rmdir(self.scratch_name, dir_fd=self.scratch_parent)
            except OSError:
                pass
            close_quietly(self.scratch_fd)
            self.scratch_fd = None
        close_quietly(self.scratch_parent)
        self.scratch_parent = None

    def open_scratch_file(self, name):
        """Open a finished scratch file and unlink it at once, so it's gone when this process is, however it ends."""
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=self.scratch())
        self.remove_scratch_file(name)
        return fd

    def remove_scratch_file(self, name):
        for suffix in ("",) + SQLITE_SIBLINGS:
            try:
                os.unlink(name + suffix, dir_fd=self.scratch())
            except OSError:
                pass

    def free_bytes(self):
        sv = os.statvfs(self.scratch())
        return sv.f_bavail * sv.f_frsize

    @contextlib.contextmanager
    def room(self, need):
        """Room on /data for a copy that may write `need` bytes, held while the copy is made.

        Each connection is its own process, so the free space one sees doesn't count what others are about to
        write. Each helper with a copy in progress says how much it may still write in the room file of its own
        scratch directory. They're read and written under an flock of /data/.ma-export-tmp itself (a lock file
        in it would be emptied by a helper starting), and a directory no live helper holds doesn't count. What's
        written so far counts twice, in the free space and in the room file, which errs on the side of the floor.
        Once a copy is made, its bytes are in the free space, so its room is given back.
        """
        self._take_room(need)
        try:
            yield
        finally:
            self._give_room(need)

    def _take_room(self, need):
        self.scratch()
        fcntl.flock(self.scratch_parent, fcntl.LOCK_EX)
        try:
            if self.free_bytes() - self.others_room() - self.reserved - need < self.free_floor:
                raise Refusal("failed", "not enough free space on /data for a consistent copy")
            self._write_room(self.reserved + need)
            self.reserved += need
        finally:
            fcntl.flock(self.scratch_parent, fcntl.LOCK_UN)

    def _give_room(self, need):
        if self.scratch_parent is None or self.scratch_fd is None:
            return
        try:
            fcntl.flock(self.scratch_parent, fcntl.LOCK_EX)
            try:
                self.reserved = max(0, self.reserved - need)
                self._write_room(self.reserved)
            finally:
                fcntl.flock(self.scratch_parent, fcntl.LOCK_UN)
        except OSError:
            pass   # the room file stays too high until this process ends, which only errs on the side of the floor

    def _write_room(self, n):
        if n <= 0:
            try:
                os.unlink(ROOM_FILE, dir_fd=self.scratch())
            except FileNotFoundError:
                pass
            return
        fd = os.open(ROOM_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
                     dir_fd=self.scratch())
        try:
            os.write(fd, str(n).encode("ascii"))
        finally:
            os.close(fd)

    def others_room(self):
        """What the other live helpers' copies in progress may still write. Called with the parent's flock held."""
        total = 0
        for name in os.listdir(self.scratch_parent):
            if name == self.scratch_name:
                continue
            try:
                cfd = os.open(name, O_DIR, dir_fd=self.scratch_parent)
            except OSError:
                continue
            try:
                try:
                    fcntl.flock(cfd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except OSError:
                    pass   # held: a live helper's
                else:
                    fcntl.flock(cfd, fcntl.LOCK_UN)
                    continue   # nobody's: its copy went with its process
                try:
                    rfd = os.open(ROOM_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=cfd)
                except OSError:
                    continue
                try:
                    total += max(0, int(os.read(rfd, 32) or b"0"))
                except ValueError:
                    pass
                finally:
                    os.close(rfd)
            finally:
                os.close(cfd)
        return total

    def new_scratch_file(self, name):
        return os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
                       dir_fd=self.scratch())

    # ---- SQLite (decision 5)

    def sqlite_copy(self, dir_fd, name, fd, st):
        """The scratch name of a consistent copy of a database, or None when SQLite can't read it as one
        (a damaged or partial file: it's sent as it is, since there's nothing to keep consistent).

        First SQLite's online backup. A program that keeps its database in exclusive locking mode, as Chromium
        does, never lets that in, so then a copy the way a crash would leave it (see _quiet_copy).
        `fd` (ours) stays open until SQLite's connections are closed: closing any fd of a file drops this
        process's POSIX locks on it, SQLite's included.
        """
        on_disk = st.st_size + sibling_size(dir_fd, name, "-wal") + sibling_size(dir_fd, name, "-journal")
        with self.room(2 * on_disk):
            return self._sqlite_copy(dir_fd, name, fd)

    def _sqlite_copy(self, dir_fd, name, fd):
        out = f"db-{secrets.token_hex(4)}"
        deadline = time.monotonic() + self.busy_s
        try:
            self._online_backup(dir_fd, name, fd, out, min(deadline, time.monotonic() + self.online_s))
            return out
        except TimeoutError:
            pass   # locked all along
        except sqlite3.Error as e:
            code = errname(e)
            self.remove_scratch_file(out)
            if code.startswith(NOT_A_DATABASE):
                return None
            if not code.startswith(("SQLITE_READONLY", "SQLITE_CANTOPEN", "SQLITE_BUSY", "SQLITE_LOCKED")):
                raise Refusal("failed", f"couldn't make a consistent copy of the database ({code or 'error'})")
            # Read-only /data: a WAL database closed cleanly has no -shm to read, and a hot journal can't be
            # rolled back here. The quiet copy handles both.
        self.remove_scratch_file(out)
        while True:
            try:
                self._quiet_copy(dir_fd, name, fd, out)
                return out
            except Changing:
                self.remove_scratch_file(out)
                if time.monotonic() >= deadline:
                    raise Refusal("failed", f"the database was locked and kept changing for {self.busy_s} s")
                time.sleep(0.25)
            except BaseException:
                self.remove_scratch_file(out)
                raise

    def _source_uri(self, dir_fd, name):
        path = os.path.join(os.readlink(f"/proc/self/fd/{dir_fd}"), name)
        return "file:" + urllib.parse.quote(os.fsencode(path), safe="/") + "?mode=ro"

    def _online_backup(self, dir_fd, name, fd, out, until):
        def progress(status, remaining, total):
            if time.monotonic() > until:
                raise TimeoutError()

        dst = sqlite3.connect(self.scratch_path(out), isolation_level=None)
        try:
            dst.execute("PRAGMA journal_mode=OFF")
            before = open_fds()
            src = sqlite3.connect(self._source_uri(dir_fd, name), uri=True, timeout=0.5, isolation_level=None)
            try:
                # One step: the whole copy under one read transaction, so a writer can't make it start over.
                src.backup(dst, pages=-1, progress=progress, sleep=0.1)
                self._check_opened(before, dir_fd, name, fd)
            finally:
                src.close()
        finally:
            dst.close()

    def _check_opened(self, before, dir_fd, name, fd):
        """SQLite opened the source by its path. Every file it opened must be one reached with O_NOFOLLOW."""
        st = os.fstat(fd)
        allowed = {(st.st_dev, st.st_ino)}
        for suffix in SQLITE_SIBLINGS:
            try:
                sst = os.stat(name + suffix, dir_fd=dir_fd, follow_symlinks=False)
                if stat.S_ISREG(sst.st_mode):
                    allowed.add((sst.st_dev, sst.st_ino))
            except OSError:
                pass
        for d in (dir_fd, self.scratch()):
            dst = os.fstat(d)
            allowed.add((dst.st_dev, dst.st_ino))
        for n in os.listdir(self.scratch()):
            try:
                sst = os.stat(n, dir_fd=self.scratch(), follow_symlinks=False)
                allowed.add((sst.st_dev, sst.st_ino))
            except OSError:
                pass
        opened = {v for k, v in open_fds().items() if before.get(k) != v}
        if (st.st_dev, st.st_ino) not in opened or not opened <= allowed:
            raise Refusal("failed", "the database's path changed while it was being copied")

    def _quiet_copy(self, dir_fd, name, fd, out):
        """The database (and its -wal or -journal) copied byte for byte while none of them changes, the way a
        crash would leave them, then opened in scratch so SQLite recovers it, and backed up into one file.

        Taken only when nothing wrote any of them for QUIET_MS before (so a write during the copy moves the
        coarse mtime) and nothing about them changed by the end. -shm is left: SQLite rebuilds it.
        """
        def snap():
            s = {}
            for suffix in ("", "-wal", "-journal"):
                try:
                    x = os.stat(name + suffix, dir_fd=dir_fd, follow_symlinks=False)
                    s[suffix] = (x.st_mode, x.st_dev, x.st_ino, x.st_size, x.st_mtime_ns, x.st_ctime_ns)
                except FileNotFoundError:
                    s[suffix] = None
            return s

        first = snap()
        mine = os.fstat(fd)
        if first[""] is None or first[""][1:3] != (mine.st_dev, mine.st_ino):
            raise Refusal("failed", "the database was replaced while it was being read")
        now = time.time_ns()
        if any(v is not None and now - max(v[4], v[5]) < self.quiet_ms * 1_000_000 for v in first.values()):
            raise Changing()
        raw = out + "-x"
        try:
            self._copy_files(dir_fd, name, fd, first, raw)
            if snap() != first:
                raise Changing()
            try:
                src = sqlite3.connect(self.scratch_path(raw), isolation_level=None)
                try:
                    dst = sqlite3.connect(self.scratch_path(out), isolation_level=None)
                    try:
                        dst.execute("PRAGMA journal_mode=OFF")
                        src.backup(dst, pages=-1)
                    finally:
                        dst.close()
                finally:
                    src.close()
            except sqlite3.Error as e:
                raise Refusal("failed", f"couldn't recover a copy of the database ({errname(e) or 'error'})")
        finally:
            self.remove_scratch_file(raw)

    def _copy_files(self, dir_fd, name, fd, first, raw):
        """The database from our fd, and a non-empty -wal or -journal opened O_NOFOLLOW, byte for byte."""
        sources = [("", fd, None)]
        try:
            for suffix in ("-wal", "-journal"):
                v = first[suffix]
                if v is not None and stat.S_ISREG(v[0]) and v[3] > 0:
                    sub_dir, sib, sst = self.open_in_part(dir_fd, (name + suffix,))
                    os.close(sub_dir)
                    sources.append((suffix, sib, sib))
                    if (sst.st_dev, sst.st_ino) != v[1:3]:
                        raise Changing()
            for suffix, src, _ in sources:
                dfd = self.new_scratch_file(raw + suffix)
                try:
                    pos = 0
                    while True:
                        b = os.pread(src, HASH_BLOCK, pos)
                        if not b:
                            break
                        pos += len(b)
                        view = memoryview(b)
                        while view:
                            view = view[os.write(dfd, view):]
                finally:
                    os.close(dfd)
        finally:
            for _, _, own in sources:
                close_quietly(own)

    # ---- browser-readable (decision 2)

    def _browser_profile(self):
        try:
            bfd = os.open("browser", O_DIR, dir_fd=self.data_fd)
        except OSError:
            return None
        try:
            return os.open("profile", O_DIR, dir_fd=bfd)
        except OSError:
            return None
        finally:
            os.close(bfd)

    def readable_entries(self):
        """The manifest of browser-readable (None when there's no browser/profile). Sizes are the sources'."""
        pfd = self._browser_profile()
        if pfd is None:
            return None
        out = []
        try:
            for prof in sorted(os.listdir(pfd), key=os.fsencode):
                if prof in BROWSER_CACHES or len(os.fsencode(prof)) > MAX_COMPONENT_BYTES:
                    continue
                try:
                    pst = os.stat(prof, dir_fd=pfd, follow_symlinks=False)
                    if not stat.S_ISDIR(pst.st_mode):
                        continue
                    dfd = os.open(prof, O_DIR, dir_fd=pfd)
                except OSError:
                    continue
                try:
                    files = []
                    for out_name, src in sorted(READABLE_FILES.items()):
                        try:
                            sst = os.stat(src, dir_fd=dfd, follow_symlinks=False)
                        except OSError:
                            continue
                        if not stat.S_ISREG(sst.st_mode):
                            continue
                        if src == "History" and read_header(dfd, src) != SQLITE_HEADER:
                            continue
                        files.append({"path": f"{prof}/{out_name}", "type": "file", "size": sst.st_size,
                                      "mtimeMs": sst.st_mtime_ns // 1_000_000, "mode": 0o644})
                finally:
                    os.close(dfd)
                if files:
                    out.append({"path": prof, "type": "dir", "size": 0, "mtimeMs": pst.st_mtime_ns // 1_000_000,
                                "mode": 0o755})
                    out.extend(files)
        finally:
            os.close(pfd)
        return out

    def make_readable(self, comps):
        """(fd, mtime_ns) of a generated bookmarks.html or history.csv, open and already unlinked."""
        if len(comps) != 2 or comps[1] not in READABLE_FILES or comps[0] in BROWSER_CACHES:
            raise Refusal("not_found", "no such file")
        pfd = self._browser_profile()
        if pfd is None:
            raise Refusal("not_found", "no such part")
        try:
            dir_fd, fd, st = self.open_in_part(pfd, (comps[0], READABLE_FILES[comps[1]]))
        finally:
            os.close(pfd)
        out = f"readable-{secrets.token_hex(4)}"
        try:
            if comps[1] == "bookmarks.html":
                if st.st_size > MAX_BOOKMARKS_BYTES:
                    raise Refusal("failed", "Bookmarks is too large to convert")
                parts, pos = [], 0
                while pos < st.st_size:
                    b = os.pread(fd, HASH_BLOCK, pos)
                    if not b:
                        break
                    parts.append(b)
                    pos += len(b)
                try:
                    text = bookmarks_html(json.loads(b"".join(parts).decode("utf-8"))).encode("utf-8")
                except (ValueError, TypeError, KeyError, AttributeError, RecursionError):
                    raise Refusal("failed", "Bookmarks isn't the JSON Chromium writes")
                with self.room(len(text)):
                    with os.fdopen(self.new_scratch_file(out), "wb") as f:
                        f.write(text)
            else:
                if os.pread(fd, 16, 0) != SQLITE_HEADER:
                    raise Refusal("not_found", "no such file")
                copy = self.sqlite_copy(dir_fd, READABLE_FILES[comps[1]], fd, st)
                if copy is None:
                    raise Refusal("failed", "History isn't a database SQLite can read")
                try:
                    with self.room(st.st_size):
                        db = sqlite3.connect(self.scratch_path(copy), isolation_level=None)
                        try:
                            db.execute("PRAGMA trusted_schema=OFF")
                            db.execute("PRAGMA query_only=ON")
                            self._write_history_csv(out, db)
                        except sqlite3.Error:
                            raise Refusal("failed", "History isn't the database Chromium writes")
                        finally:
                            db.close()
                finally:
                    self.remove_scratch_file(copy)
            return self.open_scratch_file(out), st.st_mtime_ns
        except BaseException:
            self.remove_scratch_file(out)
            raise
        finally:
            os.close(fd)
            os.close(dir_fd)

    def _write_history_csv(self, name, db):
        with os.fdopen(self.new_scratch_file(name), "w", encoding="utf-8", newline="") as f:
            f.write("﻿")   # so a spreadsheet opened with a double-click reads it as UTF-8
            w = csv.writer(f, lineterminator="\r\n")
            w.writerow(["visited_at", "title", "url"])
            rows = db.execute(
                "SELECT v.visit_time, u.title, u.url FROM visits v JOIN urls u ON u.id = v.url "
                "ORDER BY v.visit_time DESC, v.id DESC")
            for t, title, url in rows:
                w.writerow([webkit_iso(t), cell(title), cell(url)])


# ---------------------------------------------------------------- readable formats

def webkit_iso(t):
    """Chromium's microseconds since 1601-01-01 UTC as ISO 8601, to the second."""
    try:
        t = int(t)
        if t <= 0:
            return ""
        return (WEBKIT_EPOCH + datetime.timedelta(microseconds=t)).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OverflowError):
        return ""


def cell(v):
    """A CSV cell. Text a spreadsheet would run as a formula gets a leading apostrophe: page titles are anyone's."""
    s = "" if v is None else str(v)
    if s[:1] in ("=", "+", "-", "@", "\t", "\r"):
        s = "'" + s
    return s


def unix_seconds(webkit_us):
    try:
        t = int(webkit_us)
    except (TypeError, ValueError):
        return None
    return t // 1_000_000 - UNIX_FROM_WEBKIT_S if t > 0 else None


def bookmarks_html(doc):
    """The Netscape bookmark file every browser imports, laid out as Chromium's own export."""
    roots = doc["roots"]
    out = [
        "<!DOCTYPE NETSCAPE-Bookmark-file-1>",
        "<!-- This is an automatically generated file.",
        "     It will be read and overwritten.",
        "     DO NOT EDIT! -->",
        '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
        "<TITLE>Bookmarks</TITLE>",
        "<H1>Bookmarks</H1>",
        "<DL><p>",
    ]

    def dates(node, folder):
        s = ""
        added = unix_seconds(node.get("date_added"))
        if added is not None:
            s += f' ADD_DATE="{added}"'
        if folder:
            modified = unix_seconds(node.get("date_modified"))
            if modified is not None:
                s += f' LAST_MODIFIED="{modified}"'
        return s

    def node_lines(node, depth, toolbar=False):
        pad = "    " * depth
        title = html.escape(str(node.get("name", "")))
        if node.get("type") == "url":
            out.append(f'{pad}<DT><A HREF="{html.escape(str(node.get("url", "")))}"{dates(node, False)}>{title}</A>')
            return
        if node.get("type") != "folder":
            return
        extra = ' PERSONAL_TOOLBAR_FOLDER="true"' if toolbar else ""
        out.append(f"{pad}<DT><H3{dates(node, True)}{extra}>{title}</H3>")
        out.append(f"{pad}<DL><p>")
        for child in node.get("children", []):
            node_lines(child, depth + 1)
        out.append(f"{pad}</DL><p>")

    if "bookmark_bar" in roots:
        node_lines(roots["bookmark_bar"], 1, toolbar=True)
    for child in roots.get("other", {}).get("children", []):
        node_lines(child, 1)
    synced = roots.get("synced", {})
    if synced.get("children"):
        node_lines(synced, 1)
    out.append("</DL><p>")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------- entry points

def _raise_fd_limit():
    try:
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        want = min(hard, 8192) if hard != resource.RLIM_INFINITY else 8192
        if soft < want:
            resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))
    except (ValueError, OSError):
        pass


def main():
    """The socket entry point: always /data, always uid 1100. It takes no arguments."""
    os.umask(0o077)
    _raise_fd_limit()
    conn = socket.socket(fileno=0)
    Helper(DATA_ROOT, DESK_UID).serve(conn)


if __name__ == "__main__":
    main()
