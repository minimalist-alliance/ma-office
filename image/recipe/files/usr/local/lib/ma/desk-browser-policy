#!/usr/bin/python3 -I
"""desk-browser-policy: puts a teen's Browser lock in place, or takes it away, before each start of Chromium, and with it
an adult's allowlist of password managers.

Runs as root from desk-browser.service's ExecStartPre=+, so a start, a restart and a crash restart all pass through it
(image/README.md, "Teen Browser lock" and "Sign-in extensions"). deskd writes the band; only this writes the two policy
files, because deskd can't write /etc.

deskd (uid 1100) can write /data/desk, so what's there is an attacker's input to a root process. Nothing is followed,
nothing can block, and only a regular file of a few bytes is read. Exactly "adult\\n" takes the lock away and puts the
allowlist in place (ma-adult.json: the three password managers ma.json's ExtensionInstallBlocklist otherwise refuses).
Everything else takes the allowlist away and puts the lock in place: "teen\\n", no file, no /data, a symlink, a FIFO, a
directory, too many bytes, wrong case, no newline. The two files are never both in place: each path removes the other's first.

Exit 1 means Chromium mustn't start: the lock should be in place and isn't, or the allowlist should be gone and isn't. A
lock that won't come off an adult's desk, or an allowlist that won't go on, is exit 0: that desk browses filtered, or with
no extension but the blocker, which is safe, and it's better than no Browser. Logs the outcome, never contents.
"""
import json
import os
import stat
import sys

BAND_DIR = "/data/desk"
BAND_FILE = "age-band"
POLICY = "/etc/ma/chromium-teen.json"
LOCK = "/etc/chromium/policies/managed/ma-teen.json"
ADULT_POLICY = "/etc/ma/chromium-adult.json"
ADULT = "/etc/chromium/policies/managed/ma-adult.json"
OWNER = (0, 0)
MAX_BAND = 16
MAX_POLICY = 1 << 16


def log(line):
    print(f"desk-browser-policy: {line}", file=sys.stderr, flush=True)


def read_band():
    """(band, why): band is "adult" or "teen", or None for anything else, and why is safe to log."""
    try:
        dir_fd = os.open(BAND_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as e:
        return None, f"no band directory ({e.strerror})"
    try:
        fd = os.open(BAND_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError as e:
        return None, f"can't open the band ({e.strerror})"
    finally:
        os.close(dir_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "the band isn't a regular file"
        if st.st_size > MAX_BAND:
            return None, "the band is too large"
        data = os.read(fd, MAX_BAND + 1)
    except OSError as e:
        return None, f"can't read the band ({e.strerror})"
    finally:
        os.close(fd)
    if data == b"adult\n":
        return "adult", "band adult"
    if data == b"teen\n":
        return "teen", "band teen"
    return None, "the band isn't teen or adult"


def read_policy(path):
    """An image policy file's bytes. A file that isn't root's alone, or isn't a policy, would be no lock at all."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (st.st_uid, st.st_gid) != OWNER or st.st_mode & 0o022 or st.st_size > MAX_POLICY:
            raise ValueError("the policy file isn't a regular file only root can write")
        data = os.read(fd, MAX_POLICY + 1)
    finally:
        os.close(fd)
    try:
        policy = json.loads(data)
    except ValueError:
        raise ValueError("the policy file isn't JSON") from None
    if not isinstance(policy, dict) or not policy:
        raise ValueError("the policy file holds no policies")
    return data


def temp_of(path):
    return os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")


def drop_temp(temp):
    try:
        os.unlink(temp)
    except FileNotFoundError:
        pass


def install(source, target):
    """Temp file in the same directory, then rename, so Chromium's directory never holds a partial policy under that name."""
    data = read_policy(source)
    temp = temp_of(target)
    drop_temp(temp)  # what a killed run left
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    try:
        os.fchown(fd, *OWNER)
        os.fchmod(fd, 0o644)
        if os.write(fd, data) != len(data):
            raise OSError("short write")
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(temp, target)
    dir_fd = os.open(os.path.dirname(target), os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def remove(target):
    drop_temp(temp_of(target))
    try:
        os.unlink(target)
    except FileNotFoundError:
        pass


def why_not(e):
    return getattr(e, "strerror", None) or str(e)


def main():
    band, why = read_band()
    if band == "adult":
        try:
            remove(LOCK)
        except OSError as e:
            try:
                remove(ADULT)   # never both: a desk that stays locked gets no allowlist either
            except OSError:
                pass
            log(f"may still be locked: {why}, and the lock wouldn't come off ({e.strerror}); no sign-in extensions")
            return 0
        try:
            install(ADULT_POLICY, ADULT)
        except (OSError, ValueError) as e:
            try:
                remove(ADULT)
            except OSError:
                pass
            log(f"not locked: {why}; sign-in extensions not allowed: the allowlist didn't go on ({why_not(e)})")
            return 0
        log(f"not locked: {why}; sign-in extensions allowed")
        return 0
    try:
        remove(ADULT)
    except OSError as e:
        log(f"ALLOWLIST NOT REMOVED, Chromium won't start: {why}, and {e.strerror}")
        return 1
    try:
        install(POLICY, LOCK)
    except (OSError, ValueError) as e:
        log(f"LOCK NOT IN PLACE, Chromium won't start: {why}, and {why_not(e)}")
        return 1
    log(f"locked: {why}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
