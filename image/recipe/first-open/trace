#!/usr/bin/python3 -I
"""trace: list every root file the Browser stack opens, for desk-preread. Runs on the builder, from build.sh only.

Starts copies of the real units, so the commands, users and environment are the ones a desk runs: Xorg, PulseAudio,
Chromium on a throwaway profile under /run, and desk-stream against a stand-in for desk-rtc's socket. A fanotify mark
on the root filesystem records each file as it's opened, whoever opens it. Then it loads a real HTTPS page, stops everything
and writes the list. Nothing here touches /data: the builder has none, and Chromium's profile and home are on tmpfs.

Usage: trace <output list>
"""
import ctypes
import os
import re
import select
import shutil
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import urllib.request

UNITS = ["desk-xorg", "desk-audio", "desk-browser", "desk-stream"]
SRC = "/etc/systemd/system/{}.service"
DST = "/run/systemd/system/preread-trace-{}.service"
SCRATCH = "/run/preread-trace"
SOCK = "/run/desk-media/stream.sock"
CDP = "http://127.0.0.1:9222"
# The unit's ExecStartPre runs here too, so its files are on the list. The builder has no band, so it locks: this takes that off again.
LOCK = "/etc/chromium/policies/managed/ma-teen.json"
# What a list must never hold: anything per-desk or per-boot, and anything that isn't part of the image.
SKIP = ("/proc/", "/sys/", "/dev/", "/run/", "/tmp/", "/var/tmp/", "/var/log/", "/data/", "/home/", "/root/", "/var/lib/cloud/",
        "/etc/ssh/", "/var/lib/amazon/", "/var/lib/apt/", "/var/lib/dpkg/", "/var/cache/apt/", "/var/lib/docker/", "/var/lib/containerd/",
        "/var/lib/systemd/", "/var/cache/ldconfig/", "/etc/machine-id", "/opt/ma/deskd/", "/opt/ma/desk-rtc/", "/usr/lib/systemd/", "/etc/systemd/")

FAN_CLASS_NOTIF, FAN_CLOEXEC, FAN_NONBLOCK = 0x0, 0x1, 0x2
FAN_OPEN, FAN_OPEN_EXEC = 0x20, 0x1000
FAN_MARK_ADD, FAN_MARK_FILESYSTEM = 0x1, 0x100
AT_FDCWD = -100
EVENT = struct.Struct("=IBBHQii")


def fanotify():
    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    libc.fanotify_mark.argtypes = [ctypes.c_int, ctypes.c_uint, ctypes.c_uint64, ctypes.c_int, ctypes.c_char_p]
    fd = libc.fanotify_init(FAN_CLASS_NOTIF | FAN_CLOEXEC | FAN_NONBLOCK, os.O_RDONLY | os.O_CLOEXEC)
    if fd < 0:
        raise OSError(ctypes.get_errno(), "fanotify_init")
    # The whole filesystem, not the mount: desk-stream's ProtectSystem gives it a mount of its own, and a mount mark can't see that.
    if libc.fanotify_mark(fd, FAN_MARK_ADD | FAN_MARK_FILESYSTEM, FAN_OPEN | FAN_OPEN_EXEC, AT_FDCWD, b"/") < 0:
        raise OSError(ctypes.get_errno(), "fanotify_mark")
    return fd


class Recorder(threading.Thread):
    def __init__(self, fd):
        super().__init__(daemon=True)
        self.fd = fd
        self.paths = {}  # insertion order is first-open order
        self.stopping = False

    def run(self):
        while True:
            ready = select.select([self.fd], [], [], 0.2)[0]
            if not ready:
                if self.stopping:
                    return
                continue
            try:
                data = os.read(self.fd, 1 << 16)
            except BlockingIOError:
                continue
            at = 0
            while at + EVENT.size <= len(data):
                length, _v, _r, _m, _mask, efd, _pid = EVENT.unpack_from(data, at)
                at += length
                if efd < 0:
                    continue
                try:
                    self.paths.setdefault(os.readlink(f"/proc/self/fd/{efd}"), True)
                except OSError:
                    pass
                finally:
                    os.close(efd)


def write_units():
    os.makedirs(SCRATCH, exist_ok=True)
    for sub in ("profile", "home"):
        os.makedirs(os.path.join(SCRATCH, sub), exist_ok=True)
        shutil.chown(os.path.join(SCRATCH, sub), "kiosk", "kiosk")
    os.chmod(SCRATCH, 0o755)
    for u in UNITS:
        keep = []
        for line in open(SRC.format(u)):
            if line.split("=", 1)[0] in ("Requires", "After", "Wants", "ConditionPathExists", "Before", "WantedBy"):
                continue
            keep.append(line)
        text = "".join(keep)
        if u == "desk-browser":  # right after the unit's own, which this overrides, so Chromium can't reach for /data
            text = re.sub(r"(?m)^(Environment=.*)$", rf"\1\nEnvironment=HOME={SCRATCH}/home MA_BROWSER_PROFILE={SCRATCH}/profile", text, count=1)
            if "MA_BROWSER_PROFILE" not in text:
                raise SystemExit("trace: desk-browser.service has no Environment line to follow")
        with open(DST.format(u), "w") as f:
            f.write(text)
    subprocess.run(["systemctl", "daemon-reload"], check=True)


def remove_units():
    for u in reversed(UNITS):
        subprocess.run(["systemctl", "stop", f"preread-trace-{u}.service"], check=False)
        subprocess.run(["systemctl", "reset-failed", f"preread-trace-{u}.service"], check=False, stderr=subprocess.DEVNULL)
    for u in UNITS:
        try:
            os.unlink(DST.format(u))
        except OSError:
            pass
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    shutil.rmtree(SCRATCH, ignore_errors=True)
    for path in (SOCK, LOCK):
        try:
            os.unlink(path)
        except OSError:
            pass


def stand_in_for_rtc(got_video):
    """desk-rtc's end of stream.sock: start the stream and throw away what it sends."""
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)
    srv.listen(1)

    def serve():
        while True:
            conn, _ = srv.accept()
            conn.sendall(b"resume\nkeyframe\n")
            while conn.recv(1 << 16):
                got_video.set()

    threading.Thread(target=serve, daemon=True).start()


def http(method, path, timeout=3):
    req = urllib.request.Request(CDP + path, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def wait_for(what, check, seconds):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        try:
            if check():
                return True
        except OSError:
            pass
        time.sleep(0.25)
    print(f"trace: gave up waiting for {what}", file=sys.stderr)
    return False


def main():
    out = sys.argv[1]
    root_dev = os.stat("/").st_dev
    rec = Recorder(fanotify())
    rec.start()
    write_units()
    got_video = threading.Event()
    stand_in_for_rtc(got_video)
    ok = True
    try:
        for u in UNITS:
            subprocess.run(["systemctl", "start", f"preread-trace-{u}.service"], check=True, timeout=120)
        ok &= wait_for("Chromium's port", lambda: bool(http("GET", "/json/version")), 90)
        ok &= wait_for("the first video", got_video.is_set, 60)
        time.sleep(3)
        # A real page over TLS, which opens what a first navigation needs. No network here only costs a shorter list.
        try:
            http("PUT", "/json/new?https://example.com/", timeout=10)
        except OSError as e:
            print(f"trace: no page loaded: {e}", file=sys.stderr)
        time.sleep(8)
    finally:
        remove_units()
        rec.stopping = True
        rec.join(timeout=5)
    if not ok:
        return 1

    kept, total = [], 0
    for path in rec.paths:
        if path.startswith(SKIP) or not path.startswith("/"):
            continue
        try:
            st = os.lstat(path)
        except OSError:
            continue
        # Only ordinary, world-readable files on the root: desk-preread runs as nobody, and a list can't reach anything private.
        if not stat.S_ISREG(st.st_mode) or st.st_dev != root_dev or st.st_size == 0 or not st.st_mode & 0o004:
            continue
        kept.append(path)
        total += st.st_size
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write("".join(p + "\n" for p in kept))
    print(f"trace: {len(kept)} files, {total / 1e6:.0f} MB, of {len(rec.paths)} opened")
    return 0 if len(kept) > 100 else 1


if __name__ == "__main__":
    sys.exit(main())
