[Unit]
Description=desk-ice-demux: the shared host's TCP 443 under one public IPv4 (SlotMode=port), each ICE-TCP connection to its slot by its ufrag's tag (ADR 0072 section 6)
Requires=desk-host-boot.service
After=desk-host-boot.service nftables.service network-online.target
Wants=network-online.target
# desk-host-boot writes it under SlotMode=port only: a SlotMode=address host never runs the demux
ConditionPathExists=/run/desk-dmx/env

[Service]
OOMScoreAdjust=-900
Type=simple
EnvironmentFile=/run/desk-dmx/env
ExecStart=/usr/local/lib/desk-host/desk-ice-demux --listen ${DMX_LISTEN} --slots ${DMX_SLOTS} --slot-dir /run/desk-dmx/slots
Restart=always
RestartSec=2
# Its own user, the host's network namespace (it must accept on the host's address and reach every slot's veth), and only
# the two capabilities it uses: 443 below 1024, and IP_TRANSPARENT (CAP_NET_RAW), which its own seccomp filter keeps from
# opening anything but IPv4 TCP sockets (seccomp_linux.go). Nothing else of the host's: no desk's files or namespaces.
User=desk-dmx
Group=desk-dmx
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
InaccessiblePaths=-/srv/desk-host -/var/lib/desk-host -/run/desk-host -/var/log/desk-host
# Bounds beside gate.go's own: 64 waiting places a slot and 192 handed a slot, each a socket pair and a few goroutines
MemoryMax=256M
TasksMax=256
LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target
