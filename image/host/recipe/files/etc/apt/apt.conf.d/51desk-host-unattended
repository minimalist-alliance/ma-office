// The shared host's own packages (ADR 0077 section 3; desk-host-template host-apt, from desk-host-apt.timer): Debian's security
// archive only, the desk's rule (51ma-unattended). The lists are cleared first, because a later file otherwise adds to them.
#clear Unattended-Upgrade::Origins-Pattern;
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Package-Blacklist;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
};
// A restart of nftables.service would flush every slot's chains, and a reload of AppArmor's profiles would touch every slot's
// profile: they come with a host image (also held with apt-mark).
Unattended-Upgrade::Package-Blacklist {
        "^nftables$";
        "^apparmor$";
};
// Never reboot on our own: a new kernel is reported as rebootPending, and the host reboots only on Platform's reboot_host.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "false";
