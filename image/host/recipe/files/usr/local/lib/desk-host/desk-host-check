# judged only where it is), and the recipe line that sets it. image/tests/test_host_dirs.py holds every recipe line that sets one of
# these to its mode here, and desk-host-boot to setting each required one (install -d -m changes a mode that drifted).
DIRS_PREFIX = ""     # a test's temporary tree
DIRS_UID = DIRS_GID = 0   # root; a test runs as itself
DIRS = [
    (f"{DH}", 0o711, None, True, "recipe/build.sh and desk-host-boot: install -d -m 711 + chmod 711"),
    (f"{DH}/slots", 0o711, None, True, "build.sh, desk-host-boot: install -d -m 711"),
    (f"{DH}/releases", 0o711, None, True, "build.sh, desk-host-boot: install -d -m 711"),
    (f"{DH}/templates", 0o711, None, True, "build.sh, desk-host-boot: install -d -m 711"),
