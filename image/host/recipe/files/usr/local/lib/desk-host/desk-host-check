QUICK = ("runc", "zswap", "swap", "sysctl", "store", "cgroup", "classes", "slotmode", "templates", "dirs")


def main():
    names = list(CHECKS)
    if "--list" in sys.argv:
        print(" ".join(names))
        return 0
    if "--quick" in sys.argv:
        names = list(QUICK)
    if "--only" in sys.argv:
        names = sys.argv[sys.argv.index("--only") + 1].split(",")
    bad = 0
    for n in names:
        try:
            ok, detail = CHECKS[n]()
        except Exception as e:  # noqa: BLE001 - a check that can't run is a FAIL
            ok, detail = False, f"{type(e).__name__}: {e}"
        print(f"{'PASS' if ok else 'FAIL'} host {n}: {detail}", flush=True)
        bad |= not ok
    return bad


sys.exit(main())
