        "NET_RAW IPC_LOCK IPC_OWNER SYS_MODULE SYS_RAWIO SYS_CHROOT SYS_PTRACE SYS_PACCT SYS_ADMIN SYS_BOOT SYS_NICE SYS_RESOURCE SYS_TIME "
        "SYS_TTY_CONFIG MKNOD LEASE AUDIT_WRITE AUDIT_CONTROL SETFCAP MAC_OVERRIDE MAC_ADMIN SYSLOG WAKE_ALARM BLOCK_SUSPEND AUDIT_READ "
        "PERFMON BPF CHECKPOINT_RESTORE").split()
SPEC_FIELDS = (("process", "capabilities"), ("process", "noNewPrivileges"), ("process", "apparmorProfile"), ("process", "user"),
               ("process", "args"), ("process", "rlimits"), ("root",), ("mounts",), ("linux", "namespaces"), ("linux", "seccomp"),
