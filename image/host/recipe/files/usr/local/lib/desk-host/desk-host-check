def gid_of(name):
    import grp
    return grp.getgrnam(name).gr_gid


def c_dirs():
    """Every directory desk-host and runc need has the owner, group and mode the recipe sets (DIRS, each with the line that sets it)."""
    probs, n = [], 0
    want = [(p, m, g, req) for p, m, g, req, _ in DIRS]
    sd = f"{DIRS_PREFIX}{DH}/slots"
    for k in sorted(os.listdir(sd)) if os.path.isdir(sd) else []:
        if k.isdigit():   # the dot-named trees are a crashed prepare's, removed at the next start
            want += [(p.format(k=k), m, None, False) for p, m, _ in DIRS_SLOT]
    for p, mode, grp_name, req in want:
        path = DIRS_PREFIX + p
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            if req:
                probs.append(f"{p} is missing")
            continue
        n += 1
        try:
            gid = gid_of(grp_name) if grp_name else DIRS_GID
        except KeyError:
            probs.append(f"{p}: no group {grp_name}")
            continue
        if not stat.S_ISDIR(st.st_mode):
            probs.append(f"{p} isn't a directory")
        elif stat.S_IMODE(st.st_mode) != mode or st.st_uid != DIRS_UID or st.st_gid != gid:
            probs.append(f"{p} is {st.st_uid}:{st.st_gid} mode {stat.S_IMODE(st.st_mode):o}, not {DIRS_UID}:{gid} mode {mode:o}")
    return not probs, (f"{n} directories (the store, its slots/releases/templates, /var/lib/desk-host, /run/desk-host and what a slot adds) "
                       "have the recipe's owner, group and mode" if not probs else f"{probs[:6]}")


