def svc_spec_mod():
    spec = importlib.util.spec_from_file_location("desk_host_svc_spec", f"{LIB}/svc-spec.py")
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def c_svc_spec():
    """ADR 0078 section 7: every running sandbox's config.json is what svc-spec.py makes for its slot now, field by field (namespaces by
    path, capabilities, seccomp, AppArmor profile, mounts, cgroup), whether up or a live switch made it; and its process holds that:
    the bounding set, no_new_privs, seccomp filtering and the slot's AppArmor profile, read from the host's /proc. S-29: desk-rtc and
    desk-stream have the slot's stream profile (/run/desk-host/<k>/egress) read-only at /run/desk-egress. Nothing running is nothing to check."""
    probs, seen = [], 0
    mod = svc_spec_mod()
    for k in sorted(running_slots()):
        refused = set((json.load(open(f"/run/desk-host/{k}.mounts.json")) or {}).get("refused") or []) if os.path.exists(f"/run/desk-host/{k}.mounts.json") else set()
        for svc in SVC_ALL:
            st_ = sh(RUNC, "state", f"dh-svc-{k}-{svc}")
            try:
                j = json.loads(st_.stdout)
                b, pid = j["bundle"], j["pid"]
                cfg = json.load(open(f"{b}/config.json"))
            except (ValueError, KeyError, OSError):
                if svc not in refused:
                    probs.append(f"slot {k} {svc}: no sandbox")
                continue
            seen += 1
            want = mod.spec(k, svc)
            for path in SPEC_FIELDS:
                a, w = cfg, want
                for x in path:
                    a, w = (a or {}).get(x), (w or {}).get(x)
                if json.dumps(a, sort_keys=True) != json.dumps(w, sort_keys=True):
                    probs.append(f"slot {k} {svc}: {'.'.join(path)} isn't svc-spec.py's")
            if b != f"{DH}/slots/{k}/svc/{svc}":
                probs.append(f"slot {k} {svc}: its bundle is {b}")
            stat_ = {l.split(":")[0]: l.split(":", 1)[1].strip() for l in open(f"/proc/{pid}/status") if ":" in l}
            bnd = sum(1 << CAPS.index(c[4:]) for c in want["process"]["capabilities"]["bounding"])
            if int(stat_.get("CapBnd", "0"), 16) != bnd:
                probs.append(f"slot {k} {svc}: its process's bounding set {stat_.get('CapBnd')} isn't the spec's {bnd:016x}")
            if stat_.get("NoNewPrivs") != "1" or stat_.get("Seccomp") != "2":
                probs.append(f"slot {k} {svc}: no_new_privs {stat_.get('NoNewPrivs')}, seccomp {stat_.get('Seccomp')}")
            lab = rd(f"/proc/{pid}/attr/current") or ""
            if not lab.startswith(f"desk-host-{k} "):
                probs.append(f"slot {k} {svc}: AppArmor {lab!r}")
            if svc in ("desk-rtc", "desk-stream"):
                hits = [m for m in cfg.get("mounts", []) if m.get("destination") == "/run/desk-egress"]
                mi = [l.split() for l in open(f"/proc/{pid}/mountinfo") if l.split()[4] == "/run/desk-egress"]
                if len(hits) != 1 or hits[0].get("source") != f"/run/desk-host/{k}/egress" or "ro" not in hits[0].get("options", []) \
                        or not mi or "ro" not in mi[-1][5].split(","):
                    probs.append(f"slot {k} {svc}: the stream profile isn't read-only at /run/desk-egress")
    return not probs, (f"{len(running_slots())} running slot(s), {seen} sandbox(es) as svc-spec.py makes them now (spec and process); "
                       f"desk-rtc and desk-stream see the stream profile read-only" if not probs else f"{probs[:4]}")


APT_CONF = "/etc/apt/apt.conf.d/51desk-host-unattended"


def c_host_apt():
    """The host's own unattended-upgrade takes the security archive only and never reboots (51desk-host-unattended, read back as apt
    sees it), nftables and apparmor are held, policy-rc.d exits 101 while a run is on, the run is desk-host-apt.timer's through
    desk-host-upd's launcher, and Debian's own apt timers stay masked."""
    probs = []
    try:
        s_ = os.lstat(APT_CONF)
        if s_.st_uid != 0 or s_.st_mode & 0o022:
            probs.append(f"{APT_CONF} isn't root's alone")
    except OSError:
        probs.append(f"no {APT_CONF}")
    dump = sh("apt-config", "dump").stdout
    pats = re.findall(r'^Unattended-Upgrade::Origins-Pattern:: "([^"]*)";', dump, re.M)
    allowed = re.findall(r'^Unattended-Upgrade::Allowed-Origins:: "([^"]*)";', dump, re.M)
    if not pats or any("label=Debian-Security" not in x for x in pats) or allowed:
        probs.append(f"origins {pats + allowed}")
    if not re.search(r'^Unattended-Upgrade::Automatic-Reboot "false";', dump, re.M):
        probs.append("Automatic-Reboot isn't false")
    held = set(sh("apt-mark", "showhold").stdout.split())
    if not {"nftables", "apparmor"} <= held:
        probs.append(f"held {sorted(held)}, not nftables and apparmor")
    running = any(w in ("desk-host-template host-apt", "unattended-upgrade") for _, w, _ in upd_workers())
    if running or os.path.lexists("/usr/sbin/policy-rc.d"):
        r = subprocess.run(["/usr/sbin/policy-rc.d", "x", "start"], capture_output=True) if os.path.exists("/usr/sbin/policy-rc.d") else None
        if r is None or r.returncode != 101:
            probs.append(f"policy-rc.d {'missing' if r is None else 'exits ' + str(r.returncode)}{' during a run' if running else ''}")
    t = sh("systemctl", "show", "-p", "UnitFileState", "-p", "ActiveState", "desk-host-apt.timer").stdout
    if "UnitFileState=enabled" not in t or "ActiveState=active" not in t:
        probs.append(f"desk-host-apt.timer {' '.join(t.split())}")
    ex = sh("systemctl", "show", "-p", "ExecStart", "desk-host-apt.service").stdout
    if not re.search(r"desk-host-template upd -- \S*desk-host-template host-apt", ex.replace(" ;", "")):
        probs.append("desk-host-apt.service doesn't run through desk-host-upd's launcher")
    m = sh("systemctl", "is-enabled", "apt-daily.timer", "apt-daily-upgrade.timer").stdout.split()
    if any(x != "masked" for x in m):
        probs.append(f"Debian's apt timers {m}")
    if not os.path.exists("/usr/bin/unattended-upgrade"):
        probs.append("no unattended-upgrade")
    return not probs, ("security archive only, no reboot, nftables and apparmor held, policy-rc.d 101 during runs, desk-host-apt.timer through "
                       f"desk-host-upd, Debian's timers masked{'; a run is on' if running else ''}" if not probs else f"{probs[:5]}")


