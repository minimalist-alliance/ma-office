# deskd's settings, passed with docker run --env-file. Root-owned on the desk. No secrets belong here.
# Every key deskd reads is below with its default, commented out. docker takes each value literally, so no quotes.
# Uncomment a line only to point a test desk at a stand-in; a real desk runs on these defaults.

# IMDS base URL.
#DESKD_IMDS_URL=http://169.254.169.254

# Where the image's boot unit wrote "guild" or "member" (GDS-5). "guild" needs IMDS's tag to say guild; "member" takes the
# precise kind from IMDS and refuses a guild tag; anything else, or a disagreement, and deskd reads nothing and every session
# stays refused. run mounts the host's /run/ma/desk-kind there when it exists; a different path here needs a mount of its own.
#DESKD_DESK_KIND_FILE=/run/ma/desk-kind

# API base. Unset, it follows the instance's Env tag: https://api.minimalistalliance.com for prod,
# https://api.staging.minimalistalliance.com for staging. Any other Env fails closed: no hello, no sessions.
#DESKD_API_URL=

# Signing keys. Unset, it comes from config's endpoints.jwks.
#DESKD_JWKS_URL=

# deskd's data directory, bind mounted by run. /health is 503 only if this is missing or unwritable.
#DESKD_DATA_DIR=/data/desk

# Where deskd writes whether the desk is idle, for desk-batch (root), which applies Debian's updates and service batches only
# while it is (desk-runtime.md section 6.1). Rewritten whole at least every 15 s, mode 0644; its temporary file is made beside
# it, so the directory must be writable by deskd. run mounts /run/desk. Removed when deskd stops.
#DESKD_IDLE_FILE=/run/desk/idle.json

# Unix sockets, at most 107 bytes each. run mounts /run/desk for these, and health looks for the admin socket there.
#DESKD_RTC_SOCKET=/run/desk/rtc.sock
#DESKD_ADMIN_SOCKET=/run/desk/deskd-admin.sock
#DESKD_UNITS_SOCKET=/run/desk/units.sock
# desk-data, the root helper that reads the owner's files for an export. A desk without it answers data.* unavailable.
#DESKD_DATA_SOCKET=/run/desk/data.sock

# desk-agent's socket, which deskd relays agent.* to. run mounts /run/desk-agent for it. Nothing listening there is
# fine: agent.* calls get unavailable until desk-agent is up.
#DESKD_AGENT_SOCKET=/run/desk-agent/agent.sock

# desk-notebook's socket, which deskd relays notebook.* and collab to, one connection per session. run mounts
# /run/desk-notebook for it. Nothing listening there is fine: notebook.* calls get unavailable until desk-notebook is up.
#DESKD_NOTEBOOK_SOCKET=/run/desk-notebook/notebook.sock

# Commons' socket, on a guild desk only: deskd relays each member's commons channel (4) to it, one connection per
# session. run mounts /run/desk-commons for it. Other desks never connect. Nothing listening is fine: the client gets reset.
#DESKD_COMMONS_SOCKET=/run/desk-commons/commons.sock

# Chromium's debugging port on 127.0.0.1, which desk-browser.service and nftables also name.
#DESKD_CDP_PORT=9222

# Who has to hold that port: the listener's uid in /proc/net/tcp. kiosk, which desk-browser.service runs as.
#DESKD_CDP_UID=1102

# Hello's imageVersion. run passes it from version= in the host's /etc/ma-release, so leave it unset. With no such
# file and nothing here, hello sends null.
#DESKD_IMAGE_VERSION=

# deskd's own version, which the image sets from its VERSION build arg (/app/deskd.properties). Leave it unset.
#DESKD_VERSION=

# The Files app (docs/decisions/0048-files-app.md, services/deskd/docs/files.md). The image mounts /data/files into the container and
# desk-datadirs makes it (uid 1100, mode 0700); deskd answers files.* unavailable, reason tree, if it is not that.
#DESKD_FILES_ROOT=/data/files
# stub: a test desk's own env file only. Accepts the string stub.<sha256> as an image verdict token. No release image sets it.
#DESKD_FILES_IMAGE_GATE=
# Whether a verdict token whose state is unchecked (the checker was offline) is taken. The owner's rule: yes.
#DESKD_FILES_ALLOW_UNCHECKED=true
# A JWKS file to verify verdict tokens with instead of the keys deskd caches for desk tokens, until the Platform serves them.
#DESKD_FILES_VERDICT_KEYS_FILE=
