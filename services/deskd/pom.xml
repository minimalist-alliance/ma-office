<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.minimalistalliance.desk</groupId>
    <artifactId>desk-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>deskd</artifactId>
  <name>deskd</name>
  <description>Backend daemon on the desk EC2.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <exclusions>
        <!-- Configuration is properties only. -->
        <exclusion>
          <groupId>org.yaml</groupId>
          <artifactId>snakeyaml</artifactId>
        </exclusion>
        <!-- Nothing here logs through Log4j 2, but commons-logging would load it at every boot. -->
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-to-slf4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Maps and lists only. Brings just jackson-core, against databind's much larger footprint. -->
    <dependency>
      <groupId>tools.jackson.jr</groupId>
      <artifactId>jackson-jr-objects</artifactId>
    </dependency>

    <!-- Desk tokens: JWS parsing, ES256 verification and JWK checks. Claims go through our own JSON. -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>

    <!--
      Courier's envelopes (courier-envelope, the launch plan's Wave 1.4): the desk's identity and box keys, HPKE sealing and
      Ed25519 signing through Bouncy Castle's lightweight API (bcprov), contract 0.4.0's wire format.
    -->
    <dependency>
      <groupId>com.minimalistalliance.desk</groupId>
      <artifactId>courier-envelope</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      Courier's store, courier.db (draft ADR "Courier's store"): SQLite with FTS5, as desk-agent's ledgers and
      desk-notebook's pages use it. JNI, so it runs on platform threads of its own (sqlite/SqliteDatabase). The image
      takes the native library out of the jar at build time, as desk-agent's does.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Courier's parser and test kit, in tests only: the real desk-parse Courier mode answers on a stand-in socket, and the
      MIME corpus runs through the store. deskd never parses mail itself (ADR 0097), so neither is on its own classpath.
    -->
    <dependency>
      <groupId>com.minimalistalliance.desk</groupId>
      <artifactId>courier-parse</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.minimalistalliance.desk</groupId>
      <artifactId>courier-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The fake gateway in tests. Production uses the JDK's WebSocket client. -->
    <dependency>
      <groupId>org.java-websocket</groupId>
      <artifactId>Java-WebSocket</artifactId>
      <version>${java-websocket.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>deskd</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.minimalistalliance.desk.deskd.DeskdApplication</mainClass>
        </configuration>
        <executions>
          <!-- The parent pom already binds repackage; the jar keeps jarmode tools for the Dockerfile. -->
          <execution>
            <id>process-aot</id>
            <goals>
              <goal>process-aot</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- AOT output exists only after prepare-package, so the boot with it runs as an integration test. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.aot.enabled>true</spring.aot.enabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
