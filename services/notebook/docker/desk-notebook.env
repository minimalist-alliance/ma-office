# desk-notebook's settings, passed with docker run --env-file. Root-owned on the desk. No secrets belong here, and the
# service has none. Every key it reads is below with its default, commented out. docker takes each value literally, so
# no quotes. A real desk runs on these defaults.

# The data directory, bind mounted by run: notebook.db and readable/. The only place notes are, and only this reads it.
#DESK_NOTEBOOK_DATA_DIR=/data/notebook

# The socket deskd connects to, at most 107 bytes. Mode 0660; run mounts /run/desk-notebook, which the image makes
# 2750 notebook:desk, so the socket's group is desk.
#DESK_NOTEBOOK_SOCKET=/run/desk-notebook/notebook.sock

# 1 logs one line per store (page id, times, sizes). Stores over 100 ms are logged either way.
#DESK_NOTEBOOK_DEBUG=0

# Timing, for tests. The defaults are the contract's: commit within 150 ms, store 2 s after the last change and at most
# 10 s after the first, readable/ about 30 s behind.
#DESK_NOTEBOOK_COMMIT_MS=150
#DESK_NOTEBOOK_STORE_DEBOUNCE_MS=2000
#DESK_NOTEBOOK_STORE_MAX_MS=10000
#DESK_NOTEBOOK_READABLE_MS=30000

# A page's Yjs state past this takes no more, so a new client can always get it inside DATA's 4 MiB.
#DESK_NOTEBOOK_PAGE_FULL_BYTES=3670016

# The service's own version, which the image sets from its VERSION build arg. Leave it unset.
#DESK_NOTEBOOK_VERSION=
