# desk-agent's settings, passed with docker run --env-file. Root-owned on the desk. No secrets belong here: provider
# keys reach desk-agent only from deskd, and rest sealed in /data/agent/keys (ADR 0042).
# Every key desk-agent reads is below with its default, commented out. docker takes each value literally, so no quotes.
# Uncomment a line only to point a test at a stand-in; a real desk runs on these defaults.

# desk-agent's data directory, bind mounted by run: the usage ledger and the audit log. Never keys.
# /health is 503 if this is missing or unwritable, or its databases can't open.
#DESK_AGENT_DATA_DIR=/data/agent

# The health socket, at most 107 bytes. run mounts /run/desk-agent, and health looks for it there.
#DESK_AGENT_ADMIN_SOCKET=/run/desk-agent/agent-admin.sock

# The agent socket deskd connects to (docs/proposals.md section 5), at most 107 bytes. Mode 0660; run mounts
# /run/desk-agent, which the image makes 2750 agent:desk, so the socket's group is desk.
#DESK_AGENT_SOCKET=/run/desk-agent/agent.sock

# The one uid the agent socket accepts, by SO_PEERCRED: deskd's, desk (1100).
#DESK_AGENT_PEER_UID=1100

# The providers' base URLs: https, or http to loopback for a stand-in. A key never goes anywhere else in clear text.
#DESK_AGENT_ANTHROPIC_URL=https://api.anthropic.com
#DESK_AGENT_OPENAI_URL=https://api.openai.com
#DESK_AGENT_XAI_URL=https://api.x.ai

# deskd's egress proxy (design 9.8) as host:port, once it exists. Empty connects directly.
#DESK_AGENT_EGRESS_PROXY=

# desk-agent's own version, which the image sets from its VERSION build arg (/app/desk-agent.properties). Leave it
# unset.
#DESK_AGENT_VERSION=
