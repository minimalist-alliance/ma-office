{
  "id": "notebook-039",
  "area": "notebook",
  "title": "A checklist page",
  "prompt": "Create a page Packing for Lisbon in my Harness tab as a checklist: passport, charger, sunscreen.",
  "setup": {
    "notebook": [
      {
        "tab": "Harness",
        "title": "Inbox",
        "markdown": "# Inbox\n\nThings to sort later.\n"
      }
    ]
  },
  "approve": "all",
  "checks": [
    {
      "kind": "page",
      "tab": "Harness",
      "title": "Packing for Lisbon",
      "contains": [
        "passport",
        "charger",
        "sunscreen"
      ]
    },
    {
      "kind": "cards",
      "tools": [
        "notebook_write"
      ]
    }
  ],
  "policy": {
    "tools": [
      "notebook_list",
      "notebook_write"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_list",
          "input": {}
        }
      ]
    },
    {
      "calls": [
        {
          "name": "notebook_write",
          "input": {
            "op": "create",
            "new": {
              "tabId": {
                "$re": {
                  "step": 0,
                  "call": 0,
                  "pattern": "\"tabId\":\"([^\"]+)\",\"title\":\"Harness\""
                }
              },
              "title": "Packing for Lisbon"
            },
            "markdown": "- [ ] passport\n- [ ] charger\n- [ ] sunscreen"
          }
        }
      ]
    },
    {
      "text": "Made the checklist Packing for Lisbon."
    }
  ]
}
