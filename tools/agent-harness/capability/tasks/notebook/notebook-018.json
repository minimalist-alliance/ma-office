    {
      "kind": "cards",
      "tools": []
    }
  ],
  "policy": {
    "tools": [
      "notebook_search"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_search",
          "input": {
            "query": "sailing",
            "limit": 5
          }
        }
      ]
    },
    {
      "text": "I couldn't find any notes about sailing."
    }
  ]
}
