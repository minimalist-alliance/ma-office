{
  "id": "notebook-015",
  "area": "notebook",
  "title": "Append colored text",
  "prompt": "Add a line Book flights in violet text to my Trip plan page.",
  "setup": {
    "notebook": [
      {
        "tab": "Harness",
        "title": "Trip plan",
        "markdown": "# Trip plan\n\n- Renew passport\n"
      }
    ]
  },
  "approve": "all",
  "checks": [
    {
      "kind": "page",
      "tab": "Harness",
      "title": "Trip plan",
      "contains": [
        "Book flights",
        "Renew passport"
      ]
    },
    {
      "kind": "cards",
      "tools": [
        "notebook_write"
      ]
    }
  ],
  "policy": {
    "tools": [
      "notebook_search",
      "notebook_write"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_search",
          "input": {
            "query": "Trip plan"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "notebook_write",
          "input": {
            "pageId": {
              "$re": {
                "step": 0,
                "call": 0,
                "pattern": "\"pageId\":\"([^\"]+)\",\"title\":\"Trip plan\""
              }
            },
            "op": "append",
            "markdown": "<span data-text-color=\"violet\">Book flights</span>"
          }
        }
      ]
    },
    {
      "text": "Added Book flights in violet to your Trip plan."
    }
  ]
}
