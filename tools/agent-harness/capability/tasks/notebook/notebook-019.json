{
  "id": "notebook-019",
  "area": "notebook",
  "title": "Open items on a checklist",
  "prompt": "Which items on my Moving checklist page are still open?",
  "setup": {
    "notebook": [
      {
        "tab": "Harness",
        "title": "Moving checklist",
        "markdown": "# Moving checklist\n\n- [x] Book movers\n- [ ] Change address\n- [ ] Cancel internet\n"
      }
    ]
  },
  "approve": "all",
  "checks": [
    {
      "kind": "reply",
      "contains": [
        "Change address",
        "Cancel internet"
      ],
      "state": "done"
    },
    {
      "kind": "cards",
      "tools": []
    }
  ],
  "policy": {
    "tools": [
      "notebook_search",
      "notebook_read"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_search",
          "input": {
            "query": "Moving checklist"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "notebook_read",
          "input": {
            "pageId": {
              "$re": {
                "step": 0,
                "call": 0,
                "pattern": "\"pageId\":\"([^\"]+)\",\"title\":\"Moving checklist\""
              }
            }
          }
        }
      ]
    },
    {
      "text": "Still open: Change address and Cancel internet."
    }
  ]
}
