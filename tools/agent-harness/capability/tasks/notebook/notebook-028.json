{
  "id": "notebook-028",
  "area": "notebook",
  "title": "Find the highlighted item",
  "prompt": "On my Budget page, which item is highlighted?",
  "setup": {
    "notebook": [
      {
        "tab": "Harness",
        "title": "Budget",
        "markdown": "# Budget\n\n- Groceries 400\n- <mark data-color=\"blue\">Rent due 1 Dec</mark>\n- Phone 30\n"
      }
    ]
  },
  "approve": "all",
  "checks": [
    {
      "kind": "reply",
      "contains": [
        "Rent due"
      ],
      "state": "done"
    },
    {
      "kind": "cards",
      "tools": []
    }
  ],
  "policy": {
    "tools": [
      "notebook_search",
      "notebook_read"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_search",
          "input": {
            "query": "Budget"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "notebook_read",
          "input": {
            "pageId": {
              "$re": {
                "step": 0,
                "call": 0,
                "pattern": "\"pageId\":\"([^\"]+)\",\"title\":\"Budget\""
              }
            }
          }
        }
      ]
    },
    {
      "text": "The highlighted item is Rent due 1 Dec."
    }
  ]
}
