{
  "id": "notebook-049",
  "area": "notebook",
  "title": "A nested list question",
  "prompt": "On my Kids schedule page, what does Mia do on Wednesday?",
  "setup": {
    "notebook": [
      {
        "tab": "Harness",
        "title": "Kids schedule",
        "markdown": "# Kids schedule\n\n- Mia\n  - Monday: piano\n  - Wednesday: swimming\n- Leo\n  - Wednesday: chess club\n"
      }
    ]
  },
  "approve": "all",
  "checks": [
    {
      "kind": "reply",
      "contains": [
        "swimming"
      ],
      "state": "done"
    },
    {
      "kind": "cards",
      "tools": []
    }
  ],
  "policy": {
    "tools": [
      "notebook_search",
      "notebook_read"
    ]
  },
  "standIn": [
    {
      "calls": [
        {
          "name": "notebook_search",
          "input": {
            "query": "Kids schedule"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "notebook_read",
          "input": {
            "pageId": {
              "$re": {
                "step": 0,
                "call": 0,
                "pattern": "\"pageId\":\"([^\"]+)\",\"title\":\"Kids schedule\""
              }
            }
          }
        }
      ]
    },
    {
      "text": "Mia goes swimming on Wednesday."
    }
  ]
}
