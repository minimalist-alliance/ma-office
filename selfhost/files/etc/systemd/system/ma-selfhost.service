[Unit]
Description=ma-selfhost (a self-hosted desk's identity: metadata on 169.254.169.254, credentials from the platform)
Documentation=file:///usr/local/share/doc/ma-selfhost/README.md
# The key and the pairing live on /data, like the desk's DTLS identity.
Requires=desk-datadirs.service
After=desk-datadirs.service network-online.target nftables.service
Wants=network-online.target
Before=deskd.service

[Service]
User=selfhost
Group=selfhost
# As root: the metadata address on lo, and the state directory.
ExecStartPre=+/usr/local/lib/ma/selfhost/ma-selfhost-prep
ExecStart=/usr/local/lib/ma/selfhost/ma-selfhost serve
RuntimeDirectory=ma-selfhost
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# "-": the prep (as root) makes it on a fresh data disk, before this namespace is needed.
ReadWritePaths=-/data/selfhost
InaccessiblePaths=-/data/browser -/data/desk -/data/rtc
Restart=always
RestartSec=5
MemoryMax=96M

[Install]
WantedBy=multi-user.target
