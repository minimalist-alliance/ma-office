#!/usr/bin/python3 -I
"""ma-selfhost-net: keeps the firewall's home4 and home6 sets equal to the networks this desk is on (EXP-9, README.md).

nftables.conf refuses the desk's Browser (uid 1102) the private, link-local and CGNAT ranges, and holds desk-agent-filter
(uid 1106) to the internet. On a home network with IPv6, the router, printer and phones also have global addresses on the
desk's own link, and a LAN on public IPv4 has the same, so ranges alone can't cover the member's network. These sets do:
every prefix the kernel routes straight onto one of the desk's own links (no gateway), and every route learned from a
router advertisement (another segment the router announces), but never a default route, loopback, or a prefix shorter
than /8 (IPv4) or /16 (IPv6), as a VPN's two halves of the internet are.

  ma-selfhost-net fill     once: work them out, write /run/ma-selfhost-net/home.nft, load it into the running ruleset
                           and renew ipv6_ok
  ma-selfhost-net watch    fill, then again within a second of every route change (ip monitor), on SIGHUP, and every
                           minute anyway (ma-selfhost-net.service)
  ma-selfhost-net show     print them, one a line

home.nft is what nftables.conf includes after its rules, so a reload or restart of the firewall loads the latest list in
the same transaction as the rules: there's no moment with the rules and empty sets.

It fails closed (Nov 11). Each fill that loads also puts the Browser (1102) and desk-agent-filter (1106) in the set
ipv6_ok, in the same transaction, and nftables.conf gives its elements a 3-minute timeout. They get IPv6 beyond loopback
only while they're there. So if this stops, hangs, or can't read the routes or load them, their IPv6 is refused within
3 minutes (Chromium uses IPv4), while home4 keeps its last list. home.nft, which a reload of the firewall includes, never
carries them: a stale list can't open IPv6 again. Runs as root (nft needs it); it reads only `ip`'s
output and writes only its own directory.
"""
import ipaddress
import json
import os
import select
import signal
import socket
import subprocess
import sys
import time

IP = "/usr/sbin/ip" if os.path.exists("/usr/sbin/ip") else "/usr/bin/ip"
NFT = "/usr/sbin/nft"
OUT_DIR = "/run/ma-selfhost-net"
OUT_NAME = "home.nft"     # what nftables.conf includes: the sets' elements only
LOAD_NAME = "load"        # what each fill loads: the same, and ipv6_ok. Not *.nft, so the include never reads it
TABLE = "inet ma"
MIN_PREFIX = {4: 8, 6: 16}
SETTLE_S = 0.3     # route changes come in bursts (an address brings its prefix route); fill once they stop
REFRESH_S = 60     # and every minute anyway: a missed change is caught, and ipv6_ok (3 minutes) never lapses
# The Browser (kiosk) and desk-agent-filter may use IPv6 for another 3 minutes (nftables.conf's timeout on the set).
# Flushed first, so the timeout starts again whatever the kernel does with an element that's already there.
IPV6_OK = (1102, 1106)
FRESH = f"flush set {TABLE} ipv6_ok\nadd element {TABLE} ipv6_ok {{ {', '.join(map(str, IPV6_OK))} }}\n"


def log(msg):
    print(f"ma-selfhost-net: {msg}", flush=True)


def routes(family):
    r = subprocess.run([IP, "-j", f"-{family}", "route", "show", "table", "all"], capture_output=True, text=True,
                       timeout=20, stdin=subprocess.DEVNULL, check=False)
    if r.returncode != 0:
        raise RuntimeError(f"ip -{family} route failed: {r.stderr.strip()[:200]}")
    return json.loads(r.stdout or "[]")


def home_prefixes(rs, family):
    """The member's own networks among `ip -j route show table all`'s entries, collapsed and sorted."""
    nets = set()
    for r in rs:
        if not isinstance(r, dict):
            continue
        if r.get("table") == "local" or r.get("type", "unicast") != "unicast":
            continue
        dst = r.get("dst")
        if not isinstance(dst, str) or dst == "default":
            continue
        if r.get("dev") in (None, "lo"):
            continue
        onlink = not any(k in r for k in ("gateway", "via", "nexthops"))
        if not onlink and r.get("protocol") != "ra":
            continue
        try:
            net = ipaddress.ip_network(dst, strict=False)
        except ValueError:
            continue
        if net.version != family or net.prefixlen < MIN_PREFIX[family] or net.is_multicast or net.is_loopback:
            continue
        nets.add(net)
    return list(ipaddress.collapse_addresses(sorted(nets)))


def render(p4, p6):
    out = ["# ma-selfhost-net: this desk's own networks (EXP-9). Made again at every route change; nftables.conf includes it.",
           f"flush set {TABLE} home4", f"flush set {TABLE} home6"]
    if p4:
        out.append(f"add element {TABLE} home4 {{ {', '.join(str(n) for n in p4)} }}")
    if p6:
        out.append(f"add element {TABLE} home6 {{ {', '.join(str(n) for n in p6)} }}")
    return "\n".join(out) + "\n"


def write_atomic(text, name=OUT_NAME):
    os.makedirs(OUT_DIR, mode=0o755, exist_ok=True)
    tmp = os.path.join(OUT_DIR, "." + name + ".new")
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fchmod(f.fileno(), 0o644)
    os.replace(tmp, os.path.join(OUT_DIR, name))


def fill(last=None):
    """Work the sets out, write home.nft, and load it with ipv6_ok in one transaction. Returns what was loaded, or last
    when it couldn't load: then ipv6_ok isn't renewed either, and lapses."""
    p4, p6 = home_prefixes(routes(4), 4), home_prefixes(routes(6), 6)
    text = render(p4, p6)
    write_atomic(text)
    write_atomic(text + FRESH, LOAD_NAME)
    r = subprocess.run([NFT, "-f", os.path.join(OUT_DIR, LOAD_NAME)], capture_output=True, text=True, timeout=20,
                       stdin=subprocess.DEVNULL, check=False)
    if r.returncode != 0:
        # No ruleset (nftables not loaded yet): the include loads home.nft when it is. ipv6_ok isn't renewed.
        log(f"not loaded now ({r.stderr.strip()[:200]}); nftables.conf's include loads the list with the ruleset, and "
            "IPv6 stays closed to the Browser until a load works")
        return last
    if text != last:
        log(f"home4 {', '.join(map(str, p4)) or 'empty'}; home6 {', '.join(map(str, p6)) or 'empty'}")
    return text


def notify_ready():
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
        s.connect(addr)
        s.sendall(b"READY=1")


def watch():
    hup = [False]
    signal.signal(signal.SIGHUP, lambda *_: hup.__setitem__(0, True))
    # A HUP must end the wait at once: select is retried after a handler that returns, so it wakes on this pipe instead.
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    # The monitor starts first, so a change between the first fill and its start isn't missed.
    mon = subprocess.Popen([IP, "-o", "monitor", "route"], stdout=subprocess.PIPE, stdin=subprocess.DEVNULL, text=True,
                           bufsize=1)
    last = fill()
    notify_ready()
    due = None
    refresh = time.monotonic() + REFRESH_S
    while True:
        timeout = max(0.0, min((due or refresh), refresh) - time.monotonic())
        ready, _, _ = select.select([mon.stdout, wake_r], [], [], timeout)
        if wake_r in ready:
            os.read(wake_r, 512)
        if mon.stdout in ready:
            line = mon.stdout.readline()
            if not line:
                log("ip monitor stopped")
                return 1
            due = due or time.monotonic() + SETTLE_S
        now = time.monotonic()
        if hup[0] or (due and now >= due) or now >= refresh:
            hup[0], due, refresh = False, None, now + REFRESH_S
            try:
                last = fill(last)
            except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
                log(f"couldn't fill the sets ({e}); IPv6 closes to the Browser if this goes on (ipv6_ok)")


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "fill":
        fill()
        return 0
    if cmd == "show":
        for fam in (4, 6):
            for n in home_prefixes(routes(fam), fam):
                print(n)
        return 0
    if cmd == "watch":
        return watch()
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
